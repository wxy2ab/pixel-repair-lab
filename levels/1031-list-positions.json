  "stage": "explain",
  "title": {
    "zh": "列表",
    "en": "Lists"
  },
  "brief": {
    "zh": "从 0 开始数托盘上的电池。插入和移走电池后，再看看每个位置上是哪块。",
    "en": "Count the batteries on the tray from zero. Add and remove a battery, then see which battery is in each position."
  },
  "concept": {
    "zh": "列表索引会随插入和移走重新排列",
    "en": "List positions shift after insertion and removal"
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "从 0 数起",
        "en": "Count from zero"
      },
      "body": {
        "zh": "位置 0 是第一块，位置 1 是第二块。用位置查到 B 时，B 仍然留在列表里。",
        "en": "Index 0 is the first slot and index 1 is the second. Reading B at its position leaves it in the list."
      }
    },
    {
      "title": {
        "zh": "插在指定位置",
        "en": "Insert at a position"
      },
      "body": {
        "zh": "把 D 插到位置 1，D 就占住这个位置。原来在这里的 B 和后面的 C 各向右移一格。",
        "en": "Insert D at index 1, and it takes that slot. B and C each move one slot to the right."
      }
    },
    {
      "title": {
        "zh": "移走后补上空位",
        "en": "Close the gap after a removal"
      },
      "body": {
        "zh": "用 pop 移走位置 2 的 B，后面的 C 向左移一格。再查列表时，要用现在的编号。",
        "en": "Use pop to remove B at index 2. C moves left one slot. Use the new indexes when you read the list again."
      }
    }
  ],
