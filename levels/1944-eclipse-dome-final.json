  "solutionCode": "def walk(direction, squares):\n    for step in range(squares):\n        move(direction)\n\nmove(\"right\")\npick()\n\nmove(\"right\")\nshoot(\"right\")\nwalk(\"up\", 2)\npick()\n\nmove(\"down\")\nwalk(\"right\", 2)\nfor beat in range(2):\n    shoot(\"down\")\nmove(\"down\")\nwalk(\"right\", 3)\nfor beat in range(2):\n    shoot(\"up\")\nfor beat in range(2):\n    guard()\nshoot(\"up\")\nshoot(\"right\")\nguard()\nshoot(\"right\")\nwalk(\"left\", 4)\nmove(\"right\")\nshoot(\"left\")\nmove(\"up\")\nmove(\"down\")\nshoot(\"left\")\nmove(\"up\")\nmove(\"right\")\nguard()\nwalk(\"up\", 2)\nshoot(\"down\")\nwalk(\"up\", 2)\nwalk(\"right\", 6)\nwhile scan()[\"opponents\"][1][\"hp\"] > 0:\n    shoot(\"down\")\n",
