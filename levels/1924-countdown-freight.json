  "devices": [
    { "kind": "chest", "id": "cargo", "x": 3, "y": 1 },
    { "kind": "bomb", "id": "cargo-timer", "x": 5, "y": 3, "atTurn": 7 }
  ],
  "objectives": [{ "type": "collect", "itemIds": ["cargo"] }, { "type": "exit", "x": 7, "y": 2 }],
