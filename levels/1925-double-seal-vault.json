{
  "version": 1,
  "kind": "grid",
  "id": "challenge-double-seal-vault",
  "order": 1925,
  "difficulty": "advanced",
  "unit": { "id": "challenge-zone", "order": 90, "title": { "zh": "挑战场", "en": "Challenge Arena" } },
  "stage": "challenge",
  "prerequisites": [
    { "unit": "python-intermediate", "topic": "branches" },
    { "unit": "python-intermediate", "topic": "for-loops" }
  ],
  "title": { "zh": "双锁档案库", "en": "The Double-Seal Vault" },
  "concept": { "zh": "八种机关 · 双锁 · 27 回合", "en": "Eight devices · Two locks · 27 turns" },
  "brief": {
    "zh": "带档案箱离开双锁库。上层的钥匙配第一道门和箱锁；下层的开关管第二道门和激光。斜镜会转动光束的方向。脉冲炮在第 2、5、8……回合扫过通道，炸弹在第 21 回合点亮十字五格。移动、等待和开箱各用一回合。全程最多 27 回合。",
    "en": "Bring the archive chest to the exit. The upper key fits the first door and chest. The lower switch opens the second door and shuts off the laser, whose beam turns at the mirror. The cannon pulses on turns 2, 5, 8 and so on. The bomb flashes in a five-square cross on turn 21. Moving, waiting and opening the chest each take one of your 27 turns."
  },
  "hints": [],
  "tiles": [
    "############",
    "#...###..###",
    "#.####.#.###",
    "#..........#",
    "###.##.##.##",
    "###.##.##.##",
    "############"
  ],
  "start": { "x": 1, "y": 3 },
  "turnLimit": 27,
  "allowedApi": ["move", "pick", "wait"],
  "devices": [
    { "kind": "key", "id": "archive-key", "x": 3, "y": 1 },
    { "kind": "switch", "id": "floor-switch", "x": 3, "y": 5 },
    { "kind": "door", "id": "key-door", "x": 5, "y": 3, "keyId": "archive-key" },
    { "kind": "door", "id": "switch-door", "x": 7, "y": 3, "switchId": "floor-switch" },
    { "kind": "cannon", "id": "vault-pulse", "x": 6, "y": 2, "direction": "down", "period": 3, "phase": 2 },
    { "kind": "laser", "id": "vault-light", "x": 7, "y": 1, "direction": "right", "switchId": "floor-switch" },
    { "kind": "mirror", "id": "vault-mirror", "x": 8, "y": 1, "orientation": "\\" },
    { "kind": "bomb", "id": "vault-timer", "x": 9, "y": 4, "atTurn": 21 },
    { "kind": "chest", "id": "archive-chest", "x": 10, "y": 3, "keyId": "archive-key" }
  ],
  "objectives": [{ "type": "collect", "itemIds": ["archive-chest"] }, { "type": "exit", "x": 9, "y": 5 }],
  "cards": [
    { "id": "up", "label": { "zh": "向上", "en": "Move up" }, "template": "move(\"up\")" },
    { "id": "right", "label": { "zh": "向右", "en": "Move right" }, "template": "move(\"right\")" },
    { "id": "down", "label": { "zh": "向下", "en": "Move down" }, "template": "move(\"down\")" },
    { "id": "left", "label": { "zh": "向左", "en": "Move left" }, "template": "move(\"left\")" },
    {
      "id": "repeat",
      "label": { "zh": "重复几次", "en": "Repeat moves" },
      "template": "for step in range({{count}}):",
      "block": true,
      "parameters": [
        {
          "name": "count",
          "label": { "zh": "次数", "en": "Times" },
          "choices": [
            { "id": "n2", "label": { "zh": "2", "en": "2" }, "code": "2" },
            { "id": "n3", "label": { "zh": "3", "en": "3" }, "code": "3" },
            { "id": "n4", "label": { "zh": "4", "en": "4" }, "code": "4" },
            { "id": "n5", "label": { "zh": "5", "en": "5" }, "code": "5" },
            { "id": "n6", "label": { "zh": "6", "en": "6" }, "code": "6" }
          ]
        }
      ]
    },
    { "id": "pick", "label": { "zh": "打开脚下的宝箱", "en": "Open this chest" }, "template": "pick()" },
    { "id": "wait", "label": { "zh": "原地等一回合", "en": "Wait one turn" }, "template": "wait()" }
  ],
  "solutionCards": [
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "up" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "right" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "left" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "down" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "right" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "down" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "up" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "right" }] },
    { "cardId": "wait" },
    { "cardId": "repeat", "values": { "count": "n3" }, "children": [{ "cardId": "right" }] },
    { "cardId": "wait" },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "right" }] },
    { "cardId": "pick" },
    { "cardId": "left" },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "down" }] }
  ]
}
