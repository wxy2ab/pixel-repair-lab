  "title": {
    "zh": "在控制台拼出目标数",
    "en": "Build the Target Number at the Console"
  },
  "concept": {
    "zh": "用 4 到 6 位表示十进制目标",
    "en": "Represent decimal targets with four to six bits"
  },
  "brief": {
    "zh": "让每块显示板恰好显示目标数。观察最大位权，决定哪些灯该开。",
    "en": "Make each board show its target value. Look at the largest place value and decide which switches should be on."
  },
  "hints": [
    {
      "zh": "先看最大的位权能不能加入，再用右边更小的位补足余数。",
      "en": "Start with the biggest place value that fits, then use smaller places to make up the rest."
    },
    {
      "zh": "开关既能打开也能关掉。数值里每个亮灯贡献自己的位权。",
      "en": "Each switch can turn on or off. Every lit switch contributes its place value."
    }
  ],
  "mode": "binary",
  "cases": [
