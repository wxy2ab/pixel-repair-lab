  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "first_start = [8, 7]\nif scan()[\"player\"] == first_start:\n    route = [\"U\", \"U\", \"L\", \"U\", \"L\", \"D\", \"L\", \"U\", \"U\", \"U\", \"U\", \"R\", \"R\", \"R\", \"R\", \"D\", \"P\", \"D\", \"D\", \"D\", \"P\", \"L\", \"U\", \"U\", \"L\", \"L\", \"L\", \"L\", \"L\", \"U\", \"U\", \"L\", \"L\"]\nelse:\n    route = [\"D\", \"P\", \"U\", \"U\", \"U\", \"L\", \"P\", \"R\", \"U\", \"U\", \"U\", \"L\", \"L\", \"L\", \"W\", \"L\", \"L\", \"L\", \"L\", \"L\"]\ndirections = {\"U\": \"up\", \"R\": \"right\", \"D\": \"down\", \"L\": \"left\"}\nfor action in route:\n    if action == \"P\":\n        pick()\n    elif action == \"W\":\n        wait()\n    else:\n        move(directions[action])\n",
