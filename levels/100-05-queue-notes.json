  "stage": "explain",
  "title": {
    "zh": "队列",
    "en": "Queues"
  },
  "concept": {
    "zh": "队头、队尾与先进先出",
    "en": "Front, back, and first in, first out"
  },
  "brief": {
    "zh": "让电池按到达顺序从队尾加入，再从队头取走。观察两端的电池什么时候会换。",
    "en": "Let batteries join at the back in arrival order and leave from the front. Watch when the batteries at either end change."
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "新来的电池去队尾",
        "en": "New arrivals join the back"
      },
      "body": {
        "zh": "A、B、C 依次到达。每次用 append 把电池加到列表末尾。新电池成了队尾，已经在排队的电池保持原来的先后。",
        "en": "A, B, and C arrive in order. Each append adds a battery to the end of the list. It becomes the back. Batteries already in line keep their order."
      }
    },
    {
      "title": {
        "zh": "从队头取出",
        "en": "Take from the front"
      },
      "body": {
        "zh": "用 pop(0) 取走索引 0 上的电池。最早到的 A 先出队，B 往前补成新队头。",
        "en": "Use pop(0) to remove the battery at index 0. A arrived first and leaves first. B moves to the front."
      }
    },
    {
      "title": {
        "zh": "边加入边取出",
        "en": "Add and remove batteries in turns"
      },
      "body": {
        "zh": "D 到达时从队尾加入，队头仍是 B。取走 B 后，C 和 D 依次留在队里。程序按队头到队尾的顺序写下剩余电池。",
        "en": "D joins at the back and B stays at the front. After B leaves, C is ahead of D. The program writes out the remaining line from front to back."
      }
    }
  ],
  "question": {
    "prompt": {
      "zh": "A、B、C 先后到。取走 A 后，D 在队尾加入。接下来取哪块？",
      "en": "A, B, and C arrive in order. A leaves, then D joins the back. Which battery leaves next?"
    },
    "options": [
      {
        "zh": "B 号",
        "en": "B"
      },
      {
        "zh": "C 号",
        "en": "C"
      },
      {
        "zh": "D 号",
        "en": "D"
      }
    ],
    "correct": 0,
    "feedback": {
      "zh": "取走 A 后，B 最早来到仍在排队。D 从后面加入，下一块还是 B。",
      "en": "After A leaves, B is the earliest arrival still waiting. D joins behind it, so B is next."
    }
  },
