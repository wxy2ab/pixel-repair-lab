  "title": {"zh": "光束接力赛", "en": "Crossbeam Relay"},
  "concept": {"zh": "双光路 · 脉冲时机", "en": "Crossed beams · Pulse timing"},
  "brief": {
    "zh": "取出宝箱里的计时器，把它带到终点。下方的压板管左上角的激光。交叉口的压板管右上角的激光。踩上压板的当回合，对应的光束就会熄灭。脉冲炮每隔 4 回合扫过箱子，第一次在第 4 回合。开箱占一回合。最多用 19 回合。",
    "en": "Collect the race clock from its chest and carry it to the finish. The lower plate controls the top-left laser. The plate at the crossing controls the top-right one. A beam switches off on the turn its plate is pressed. The cannon sweeps the chest every four turns, starting on turn 4. Opening the chest takes a turn. You have 19 turns."
  },
  "hints": [],
  "tiles": [
    "############",
    "#....##.#.##",
    "####.##.#.##",
    "#.........##",
    "#.##.##..###",
    "#....##...##",
    "#....#######",
    "############"
  ],
  "start": {"x": 1, "y": 5},
  "turnLimit": 19,
  "allowedApi": ["move", "pick", "wait"],
  "devices": [
    {"kind": "laser", "id": "eastbound-beam", "x": 1, "y": 1, "direction": "right", "switchId": "lower-plate"},
    {"kind": "mirror", "id": "upper-elbow", "x": 4, "y": 1, "orientation": "\\"},
    {"kind": "cannon", "id": "pulse-scanner", "x": 7, "y": 1, "direction": "down", "period": 4, "phase": 0},
    {"kind": "laser", "id": "southbound-beam", "x": 9, "y": 1, "direction": "down", "switchId": "crossing-plate"},
    {"kind": "switch", "id": "crossing-plate", "x": 4, "y": 3},
    {"kind": "mirror", "id": "east-elbow", "x": 9, "y": 3, "orientation": "/"},
    {"kind": "chest", "id": "race-clock", "x": 7, "y": 4},
    {"kind": "switch", "id": "lower-plate", "x": 4, "y": 6}
  ],
  "objectives": [{"type": "collect", "itemIds": ["race-clock"]}, {"type": "exit", "x": 9, "y": 5}],
  "cards": [
    {"id": "up", "label": {"zh": "向上", "en": "Move up"}, "template": "move(\"up\")"},
    {"id": "right", "label": {"zh": "向右", "en": "Move right"}, "template": "move(\"right\")"},
    {"id": "down", "label": {"zh": "向下", "en": "Move down"}, "template": "move(\"down\")"},
    {"id": "left", "label": {"zh": "向左", "en": "Move left"}, "template": "move(\"left\")"},
    {"id": "pick", "label": {"zh": "打开脚下的宝箱", "en": "Open this chest"}, "template": "pick()"},
    {"id": "wait", "label": {"zh": "等一回合", "en": "Wait one turn"}, "template": "wait()"},
    {
      "id": "repeat",
      "label": {"zh": "重复几次", "en": "Repeat moves"},
