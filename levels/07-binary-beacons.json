  "stage": "exercise",
  "title": {
    "zh": "把灯读成数字",
    "en": "Read the Beacon Lights"
  },
  "concept": {
    "zh": "二进制位权",
    "en": "Binary place values"
  },
  "brief": {
    "zh": "三盏灯表示一个二进制数。亮灯是 1，灭灯是 0。扫描三盏灯，提交它们表示的十进制数。",
    "en": "Three lights represent a binary number. A lit light is 1 and an unlit light is 0. Scan all three and submit the number in decimal."
  },
  "hints": [
    {
      "zh": "最右边的一位值 1。向左每移一位，位权翻倍。",
      "en": "The rightmost place is worth 1. Each place to its left is worth twice as much."
    },
    {
      "zh": "用每一位的 0 或 1 乘上它的位权，再把结果加起来。",
      "en": "Multiply each 0 or 1 by its place value, then add the results."
    }
  ],
  "tiles": [
    "#########",
    "#.......#",
    "#.#####.#",
    "#.......#",
    "#.#####.#",
    "#.......#",
    "#########"
