{
  "version": 1,
  "kind": "grid",
  "id": "challenge-mirror-mailrooms",
  "order": 1929,
  "difficulty": "advanced",
  "unit": {"id": "challenge-zone", "order": 90, "title": {"zh": "挑战场", "en": "Challenge Arena"}},
  "stage": "challenge",
  "prerequisites": [{"unit": "python-intermediate", "topic": "branches"}, {"unit": "python-intermediate", "topic": "for-loops"}],
  "title": {"zh": "镜像邮局的夜班", "en": "Night Shift at the Mirror Post"},
  "concept": {"zh": "镜像地图 · 双钥匙 · 光闸", "en": "Mirror maps · Two keys · Laser cutoff"},
  "brief": {
    "zh": "用同一份程序在两间邮局取出月亮邮票，送到各自的出口。两间邮局的布局左右相反。钥匙架上的钥匙开通道门。门后小隔间里的钥匙开邮票箱。踩上压板会切断镜子折向走廊的激光。每张地图最多用 33 回合。",
    "en": "Use one program to collect the moon stamps in both post offices and bring them to each exit. The two floor plans are mirror images. The key on the rack fits the passage door. The key in the alcove beyond the door fits the stamp chest. The floor plate cuts power to the beam reflected down the hall. You have 33 turns on each map."
  },
  "hints": [],
  "tiles": [
    "#############",
    "##...##...###",
    "##.##.#.#####",
    "##..........#",
    "##.##.###.#.#",
    "##......###.#",
    "#############"
  ],
  "start": {"x": 7, "y": 5},
  "turnLimit": 33,
  "allowedApi": ["move", "pick", "scan"],
  "devices": [
    {"kind": "key", "id": "brass-key", "x": 4, "y": 1},
    {"kind": "mirror", "id": "ledger-mirror", "x": 7, "y": 1, "orientation": "/"},
    {"kind": "laser", "id": "desk-laser", "x": 9, "y": 1, "direction": "left", "switchId": "isolator"},
    {"kind": "switch", "id": "isolator", "x": 5, "y": 2},
    {"kind": "door", "id": "ledger-door", "x": 8, "y": 3, "keyId": "brass-key"},
    {"kind": "chest", "id": "moon-stamps", "x": 11, "y": 3, "keyId": "ink-key"},
    {"kind": "key", "id": "ink-key", "x": 9, "y": 4}
  ],
  "objectives": [{"type": "collect", "itemIds": ["moon-stamps"]}, {"type": "exit", "x": 11, "y": 5}],
  "variants": [
    {
      "tiles": [
        "#############",
        "###...##...##",
        "#####.#.##.##",
        "#..........##",
        "#.#.###.##.##",
        "#.###......##",
        "#############"
      ],
      "start": {"x": 5, "y": 5},
      "devices": [
        {"kind": "key", "id": "brass-key", "x": 8, "y": 1},
        {"kind": "mirror", "id": "ledger-mirror", "x": 5, "y": 1, "orientation": "\\"},
        {"kind": "laser", "id": "desk-laser", "x": 3, "y": 1, "direction": "right", "switchId": "isolator"},
        {"kind": "switch", "id": "isolator", "x": 7, "y": 2},
        {"kind": "door", "id": "ledger-door", "x": 4, "y": 3, "keyId": "brass-key"},
        {"kind": "chest", "id": "moon-stamps", "x": 1, "y": 3, "keyId": "ink-key"},
        {"kind": "key", "id": "ink-key", "x": 3, "y": 4}
      ],
      "objectives": [{"type": "collect", "itemIds": ["moon-stamps"]}, {"type": "exit", "x": 1, "y": 5}]
    }
  ],
  "cards": [
    {"id": "up", "label": {"zh": "向上", "en": "Move up"}, "template": "move(\"up\")"},
    {"id": "right", "label": {"zh": "向右", "en": "Move right"}, "template": "move(\"right\")"},
    {"id": "down", "label": {"zh": "向下", "en": "Move down"}, "template": "move(\"down\")"},
    {"id": "left", "label": {"zh": "向左", "en": "Move left"}, "template": "move(\"left\")"},
    {"id": "pick", "label": {"zh": "打开脚下的宝箱", "en": "Open this chest"}, "template": "pick()"},
    {
      "id": "repeat",
      "label": {"zh": "重复几次", "en": "Repeat moves"},
      "template": "for step in range({{count}}):",
      "block": true,
      "parameters": [
        {
          "name": "count",
          "label": {"zh": "次数", "en": "Times"},
          "choices": [
            {"id": "n2", "label": {"zh": "2", "en": "2"}, "code": "2"},
            {"id": "n3", "label": {"zh": "3", "en": "3"}, "code": "3"},
            {"id": "n4", "label": {"zh": "4", "en": "4"}, "code": "4"},
            {"id": "n5", "label": {"zh": "5", "en": "5"}, "code": "5"},
            {"id": "n6", "label": {"zh": "6", "en": "6"}, "code": "6"}
          ]
        }
      ]
    },
    {
      "id": "set-side",
      "label": {"zh": "记住方向", "en": "Remember a direction"},
      "template": "{{slot}} = {{side}}",
      "parameters": [
        {
          "name": "slot",
          "label": {"zh": "方向名", "en": "Direction name"},
          "choices": [
            {"id": "key", "label": {"zh": "钥匙架方向", "en": "Key rack side"}, "code": "rack_side"},
            {"id": "stamp", "label": {"zh": "邮票箱方向", "en": "Stamp chest side"}, "code": "stamp_side"}
          ]
        },
        {
          "name": "side",
          "label": {"zh": "往哪边", "en": "Which side"},
          "choices": [
            {"id": "left", "label": {"zh": "左", "en": "Left"}, "code": "\"left\""},
            {"id": "right", "label": {"zh": "右", "en": "Right"}, "code": "\"right\""}
          ]
        }
      ]
    },
    {
      "id": "check-wall",
      "label": {"zh": "如果这边是墙", "en": "If this side is a wall"},
      "template": "if scan()[{{side}}] == \"wall\":",
      "block": true,
      "parameters": [
        {
          "name": "side",
          "label": {"zh": "往哪边", "en": "Which side"},
          "choices": [
            {"id": "left", "label": {"zh": "左", "en": "Left"}, "code": "\"left\""},
            {"id": "right", "label": {"zh": "右", "en": "Right"}, "code": "\"right\""}
          ]
        }
      ]
    },
    {
      "id": "along",
      "label": {"zh": "沿记住的方向走", "en": "Follow a saved direction"},
      "template": "move({{slot}})",
      "parameters": [
        {
          "name": "slot",
          "label": {"zh": "方向名", "en": "Direction name"},
          "choices": [
            {"id": "key", "label": {"zh": "钥匙架方向", "en": "Key rack side"}, "code": "rack_side"},
            {"id": "stamp", "label": {"zh": "邮票箱方向", "en": "Stamp chest side"}, "code": "stamp_side"}
          ]
        }
      ]
    }
  ],
  "solutionCards": [
    {"cardId": "set-side", "values": {"slot": "key", "side": "left"}},
    {"cardId": "set-side", "values": {"slot": "stamp", "side": "right"}},
    {
      "cardId": "check-wall",
      "values": {"side": "left"},
      "children": [
        {"cardId": "set-side", "values": {"slot": "key", "side": "right"}},
        {"cardId": "set-side", "values": {"slot": "stamp", "side": "left"}}
      ]
    },
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "along", "values": {"slot": "key"}}]},
    {"cardId": "repeat", "values": {"count": "n3"}, "children": [{"cardId": "up"}]},
    {"cardId": "down"},
    {"cardId": "repeat", "values": {"count": "n3"}, "children": [{"cardId": "along", "values": {"slot": "key"}}]},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "up"}]},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "along", "values": {"slot": "stamp"}}]},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "along", "values": {"slot": "key"}}]},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "down"}]},
    {"cardId": "repeat", "values": {"count": "n6"}, "children": [{"cardId": "along", "values": {"slot": "stamp"}}]},
    {"cardId": "along", "values": {"slot": "stamp"}},
    {"cardId": "down"},
    {"cardId": "up"},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "along", "values": {"slot": "stamp"}}]},
    {"cardId": "pick"},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "down"}]}
  ]
}
