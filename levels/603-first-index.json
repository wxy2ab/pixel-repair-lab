  "id": "first-index",
  "order": 603,
  "title": {
    "zh": "第一个匹配的位置",
    "en": "First matching index"
  },
  "brief": {
    "zh": "实现 first_index(values, target)。返回第一个匹配的索引，找不到就返回 -1。",
    "en": "Implement first_index(values, target). Return the first match index or -1."
  },
  "concept": {
    "zh": "顺序比较与提前返回",
    "en": "Ordered comparisons and early return"
  },
  "hints": [
    {
      "zh": "匹配时就在循环内返回。用于找不到的 -1 放在循环后。",
      "en": "Return a match inside the loop. Put -1 after the loop."
    }
  ],
  "functionName": "first_index",
  "starterCode": "def first_index(values, target):\n    return -1",
  "solutionCode": "def first_index(values, target):\n    for index in range(len(values)):\n        if values[index] == target:\n            return index\n    return -1",
  "snippets": [
    {
      "label": {
        "zh": "遍历所有索引",
        "en": "Loop over indexes"
      },
      "code": "    for index in range(len(values)):\n        pass"
    },
    {
      "label": {
        "zh": "匹配时返回",
        "en": "Return a match"
      },
      "code": "        if values[index] == target:\n            return index"
    }
  ],
