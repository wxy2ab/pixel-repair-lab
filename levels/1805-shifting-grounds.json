  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "def graph_for(board, width):\n    graph = {}\n    for y in range(len(board)):\n        for x in range(width):\n            if board[y][x] == \"#\":\n                continue\n            neighbors = []\n            for step in [[0, -1, \"up\"], [1, 0, \"right\"], [0, 1, \"down\"], [-1, 0, \"left\"]]:\n                nx = x + step[0]\n                ny = y + step[1]\n                if 0 <= nx and nx < width and 0 <= ny and ny < len(board) and board[ny][nx] == \".\":\n                    neighbors.append([ny * width + nx, step[2]])\n            graph[y * width + x] = neighbors\n    return graph\n\ndef routes(graph, cache, start):\n    if start in cache:\n        return cache[start]\n    queue = [start]\n    table = {start: [0, None]}\n    for cell in queue:\n        distance = table[cell][0]\n        first = table[cell][1]\n        for edge in graph[cell]:\n            neighbor = edge[0]\n            if neighbor in table:\n                continue\n            direction = first\n            if direction is None:\n                direction = edge[1]\n            table[neighbor] = [distance + 1, direction]\n            queue.append(neighbor)\n    cache[start] = table\n    return table\n\ndef rival_distances(graph, cache, width, opponents):\n    tables = []\n    for opponent in opponents:\n        tables.append(routes(graph, cache, opponent[\"y\"] * width + opponent[\"x\"]))\n    return tables\n\ndef nearest_rival(tables, target):\n    nearest = 999\n    for table in tables:\n        if target in table and table[target][0] < nearest:\n            nearest = table[target][0]\n    return nearest\n\ndef choose_action(state, width, graph, cache):\n    player = state[\"player\"]\n    start = player[1] * width + player[0]\n    items = state[\"items\"]\n    for item in items:\n        if item[\"y\"] * width + item[\"x\"] == start:\n            return \"pick\"\n    own_routes = routes(graph, cache, start)\n    rivals = rival_distances(graph, cache, width, state[\"opponents\"])\n    chosen = None\n    best_safe = False\n    best_distance = 999\n    best_lead = -999\n    for item in items:\n        target = item[\"y\"] * width + item[\"x\"]\n        if target not in own_routes:\n            continue\n        distance = own_routes[target][0]\n        lead = nearest_rival(rivals, target) - distance\n        safe = lead > 0\n        if chosen is None or (safe and not best_safe) or (safe == best_safe and (distance < best_distance or (distance == best_distance and lead > best_lead))):\n            chosen = target\n            best_safe = safe\n            best_distance = distance\n            best_lead = lead\n    if chosen is None:\n        return \"wait\"\n    return own_routes[chosen][1]\n\nboard = []\ncache = {}\nwhile True:\n    state = scan()\n    if state[\"tiles\"] != board:\n        board = state[\"tiles\"]\n        width = len(board[0])\n        graph = graph_for(board, width)\n        cache = {}\n    action = choose_action(state, width, graph, cache)\n    if action == \"pick\":\n        pick()\n    elif action == \"wait\":\n        wait()\n    else:\n        move(action)\n",
