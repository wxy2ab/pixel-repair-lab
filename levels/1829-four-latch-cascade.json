  "cards": [
    {
      "id": "read",
      "label": {
        "zh": "读取锁站信号",
        "en": "Read latch signals"
      },
      "template": "panel = scan()"
    },
    {
      "id": "initial",
      "label": {
        "zh": "设定开关初始状态",
        "en": "Set the initial switch state"
      },
      "template": "phase = panel[\"initial\"]"
    },
    {
      "id": "latches",
      "label": {
        "zh": "逐道处理闸门",
        "en": "Process one latch at a time"
      },
      "template": "for signals in panel[\"blocks\"]:",
      "block": true
    },
    {
      "id": "signals",
      "label": {
        "zh": "逐个读取本闸信号",
        "en": "Read each signal for this latch"
      },
      "template": "for signal in signals:",
      "block": true
    },
    {
      "id": "if-bit",
      "label": {
        "zh": "如果收到 1",
        "en": "If the signal is 1"
      },
      "template": "if signal == 1:",
      "block": true
    },
    {
      "id": "toggle",
      "label": {
        "zh": "翻转开关",
        "en": "Flip the switch"
      },
      "template": "phase = 1 - phase"
    },
    {
      "id": "if-upper",
      "label": {
        "zh": "如果状态是 0",
        "en": "If the switch is 0"
      },
      "template": "if phase == 0:",
      "block": true
    },
    {
      "id": "otherwise",
      "label": {
        "zh": "否则",
        "en": "Otherwise"
      },
      "template": "else:",
      "block": true
    },
    {
      "id": "route-up",
      "label": {
        "zh": "记录上路及返回方向",
        "en": "Choose the upper route and return direction"
      },
      "template": "route = [\"up\", \"down\"]"
    },
    {
      "id": "route-down",
      "label": {
        "zh": "记录下路及返回方向",
        "en": "Choose the lower route and return direction"
      },
      "template": "route = [\"down\", \"up\"]"
    },
    {
      "id": "enter",
      "label": {
        "zh": "走进当前开通的路",
        "en": "Enter the currently open route"
      },
      "template": "move(route[0])"
    },
    {
      "id": "leave",
      "label": {
        "zh": "返回中间通道",
        "en": "Return to the middle lane"
      },
      "template": "move(route[1])"
    },
    {
      "id": "right",
      "label": {
        "zh": "向右",
        "en": "Right"
      },
      "template": "move(\"right\")"
    },
    {
      "id": "pick",
      "label": {
        "zh": "拾取零件",
        "en": "Pick up the part"
      },
      "template": "pick()"
    }
