  "cards": [
    {
      "id": "read",
      "label": {
        "zh": "读取图纸和工单",
        "en": "Read plan and work order"
      },
      "template": "board = scan()"
    },
    {
      "id": "N",
      "label": {
        "zh": "图纸北",
        "en": "Plan north"
      },
      "template": "move(board[\"compass\"][\"N\"])"
    },
    {
      "id": "E",
      "label": {
        "zh": "图纸东",
        "en": "Plan east"
      },
      "template": "move(board[\"compass\"][\"E\"])"
    },
    {
      "id": "S",
      "label": {
        "zh": "图纸南",
        "en": "Plan south"
      },
      "template": "move(board[\"compass\"][\"S\"])"
    },
    {
      "id": "W",
      "label": {
        "zh": "图纸西",
        "en": "Plan west"
      },
      "template": "move(board[\"compass\"][\"W\"])"
    },
    {
      "id": "grab",
      "label": {
        "zh": "拾取并读取件名",
        "en": "Pick up and read the ID"
      },
      "template": "part = pick()"
    },
    {
      "id": "first",
      "label": {
        "zh": "准备第一笔记录",
        "en": "Mark the first reading"
      },
      "template": "first = True"
    },
    {
      "id": "value",
      "label": {
        "zh": "查本件读数",
        "en": "Look up this reading"
      },
      "template": "value = board[\"readings\"][part]"
    },
    {
      "id": "low",
      "label": {
        "zh": "第一次或低于最低值",
        "en": "First reading or a new low"
      },
      "template": "if first or value < low:",
      "block": true
    },
    {
      "id": "keep-low",
      "label": {
        "zh": "记下最低值",
        "en": "Record the low"
      },
      "template": "low = value"
    },
    {
      "id": "high",
      "label": {
        "zh": "第一次或高于最高值",
        "en": "First reading or a new high"
      },
      "template": "if first or value > high:",
      "block": true
    },
    {
      "id": "keep-high",
      "label": {
        "zh": "记下最高值",
        "en": "Record the high"
      },
      "template": "high = value"
    },
    {
      "id": "next",
      "label": {
        "zh": "结束第一笔",
        "en": "Mark first reading complete"
      },
      "template": "first = False"
    },
    {
      "id": "save-low",
      "label": {
        "zh": "存最低值",
        "en": "Store the low"
      },
      "template": "store(0, low)"
    },
    {
      "id": "save-high",
      "label": {
        "zh": "存最高值",
        "en": "Store the high"
      },
      "template": "store(1, high)"
    },
    {
      "id": "save-range",
      "label": {
        "zh": "存极差",
        "en": "Store the range"
      },
      "template": "store(2, high - low)"
    },
    {
      "id": "report",
      "label": {
        "zh": "读内存并提交",
        "en": "Submit the stored range"
      },
      "template": "submit(load(2))"
    }
  ],
