  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "state = scan()\nif state[\"player\"][0] < 7:\n    plan = [\"right\",\"down\",\"down\",\"left\",\"pick\",\"right\",\"up\",\"up\",\"right\",\"right\",\"right\",\"right\",\"right\",\"up\",\"up\",\"right\",\"right\",\"pick\",\"down\",\"down\",\"down\",\"wait\",\"down\",\"down\",\"left\"]\nelse:\n    plan = [\"right\",\"down\",\"down\",\"left\",\"pick\",\"left\",\"up\",\"up\",\"left\",\"left\",\"left\",\"left\",\"left\",\"up\",\"up\",\"left\",\"left\",\"pick\",\"down\",\"down\",\"down\",\"wait\",\"down\",\"down\",\"right\"]\nfor action in plan:\n    if action == \"pick\":\n        pick()\n    elif action == \"wait\":\n        wait()\n    else:\n        move(action)\n",
  "snippets": [
    {
      "label": {
        "zh": "查看对手位置",
        "en": "Read opponent positions"
      },
      "code": "state = scan()\nfor robot in state[\"opponents\"]:\n    x = robot[\"x\"]\n    y = robot[\"y\"]"
    },
    {
      "label": {
        "zh": "迈向当前目标",
        "en": "Step toward a target"
      },
      "code": "from algorithms import shortest_step\nstate = scan()\ntarget = state[\"exit\"]\ndirection = shortest_step(state[\"tiles\"], state[\"player\"], target)\nif direction is not None:\n    move(direction)"
    }
