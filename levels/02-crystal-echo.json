  "brief": {
    "zh": "先到晶石所在的格子把它拾起来，然后带着晶石抵达出口。",
    "en": "Reach the crystal, pick it up, and carry it to the exit."
  },
  "hints": [
    {
      "zh": "scan() 查看相邻四格。pick() 拾取机器人脚下的晶石。",
      "en": "scan() checks the four neighboring tiles. pick() picks up a crystal on Sprout's tile."
    },
    {
      "zh": "先数到晶石要走几格，再数晶石到出口有几格。",
      "en": "Count the moves to the crystal first, then count the moves from the crystal to the exit."
    }
  ],
