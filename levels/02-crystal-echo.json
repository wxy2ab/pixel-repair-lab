  "tutorial": [
    {
      "text": {
        "zh": "找到晶石。它就在机器人和出口之间。",
        "en": "Find the crystal. It is between Sprout and the exit."
      },
      "target": "board"
    },
    {
      "text": {
        "zh": "向右走到晶石旁边，再用「扫描周围」看看哪一格里有晶石。",
        "en": "Move right until you are beside the crystal, then use Scan Nearby to see which neighboring tile holds it."
      },
      "target": "palette"
    },
    {
      "text": {
        "zh": "把「拾起晶石」放在机器人到达晶石之后，再添加到出口的移动。",
        "en": "Put Pick Up a Crystal after the moves to the crystal, then add the moves to the exit."
      },
      "target": "program"
    },
    {
      "text": {
        "zh": "运行程序，观察哪一步让晶石进入背包。",
        "en": "Run your program and watch which step adds the crystal to your collection."
      },
      "target": "run"
    }
  ]
