        { "id": "night-parcel", "kind": "chest", "x": 9, "y": 4 }
      ],
      "objectives": [{ "type": "collect", "itemIds": ["night-parcel"] }, { "type": "exit", "x": 10, "y": 4 }],
      "turnLimit": 18
    }
  ],
  "allowedApi": ["move", "scan", "wait", "pick"],
  "cards": [
    { "id": "up", "label": { "zh": "向上", "en": "Move up" }, "template": "move(\"up\")" },
    { "id": "right", "label": { "zh": "向右", "en": "Move right" }, "template": "move(\"right\")" },
    { "id": "down", "label": { "zh": "向下", "en": "Move down" }, "template": "move(\"down\")" },
    { "id": "left", "label": { "zh": "向左", "en": "Move left" }, "template": "move(\"left\")" },
    { "id": "wait", "label": { "zh": "等一回合", "en": "Wait one turn" }, "template": "wait()" },
    { "id": "pick", "label": { "zh": "打开脚下的宝箱", "en": "Open this chest" }, "template": "pick()" },
    {
      "id": "repeat",
      "label": { "zh": "重复几次", "en": "Repeat" },
      "template": "for step in range({{count}}):",
      "block": true,
      "parameters": [
        {
          "name": "count",
          "label": { "zh": "次数", "en": "Times" },
          "choices": [
            { "id": "n2", "label": { "zh": "2", "en": "2" }, "code": "2" },
            { "id": "n3", "label": { "zh": "3", "en": "3" }, "code": "3" },
            { "id": "n4", "label": { "zh": "4", "en": "4" }, "code": "4" },
            { "id": "n5", "label": { "zh": "5", "en": "5" }, "code": "5" },
            { "id": "n6", "label": { "zh": "6", "en": "6" }, "code": "6" }
          ]
        }
      ]
    },
    {
      "id": "if-floor",
      "label": { "zh": "如果旁边是地板", "en": "If the neighboring tile is floor" },
      "template": "if scan()[{{side}}] == \"floor\":",
      "block": true,
      "parameters": [
        {
          "name": "side",
          "label": { "zh": "方向", "en": "Direction" },
          "choices": [
            { "id": "up", "label": { "zh": "上", "en": "up" }, "code": "\"up\"" },
            { "id": "right", "label": { "zh": "右", "en": "right" }, "code": "\"right\"" },
            { "id": "down", "label": { "zh": "下", "en": "down" }, "code": "\"down\"" },
            { "id": "left", "label": { "zh": "左", "en": "left" }, "code": "\"left\"" }
          ]
        }
      ]
    },
    { "id": "otherwise", "label": { "zh": "否则", "en": "Otherwise" }, "template": "else:", "block": true }
  ],
  "solutionCards": [
