  "prerequisites": [{ "unit": "python-intermediate", "topic": "branches" }, { "unit": "python-intermediate", "topic": "for-loops" }],
  "title": { "zh": "夜邮岔站", "en": "Night Mail Junction" },
  "concept": { "zh": "双站台 · 探路 · 脉冲窗口", "en": "Two stations · Scouting · Pulse windows" },
  "brief": {
    "zh": "用同一份程序在两个邮站开箱取信，送到各自的出口。北站和南站各有一条支线通往激光断电开关。scan() 能读到芽芽四周的地形。北站的炮从第 2 回合起每隔 3 回合扫过邮箱。南站的炮从第 3 回合起每隔 4 回合扫过邮箱。开箱也要在箱子上用掉一回合。北站限 17 回合，南站限 18 回合。",
    "en": "Use one program to open the mail chest and deliver the letters to the exit at both stations. Each station has a different side track to its laser cutoff switch. scan() reports the tiles next to Sprout. The north station cannon sweeps the chest every three turns starting on turn 2. The south station cannon sweeps it every four turns starting on turn 3. Opening the chest uses one turn on its tile. The north station allows 17 turns and the south station allows 18."
  },
  "hints": [],
  "tiles": [
    "############",
    "###.########",
    "#.....######",
    "#.###.##.###",
    "#.#........#",
    "#########.##",
    "#########.##",
    "############"
  ],
  "start": { "x": 1, "y": 4 },
