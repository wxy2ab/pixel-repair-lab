    { "id": "night-parcel", "kind": "chest", "x": 9, "y": 4 }
  ],
  "objectives": [{ "type": "collect", "itemIds": ["night-parcel"] }, { "type": "exit", "x": 10, "y": 4 }],
  "turnLimit": 17,
