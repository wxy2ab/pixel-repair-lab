      "title": {
        "zh": "把收到的线缆和垫圈分类计数",
        "en": "Count how many cables and washers arrived"
      },
      "source": "parts = scan()\ncounts = {}\nfor part in parts:\n    if part in counts:\n        counts[part] = counts[part] + 1\n    else:\n        counts[part] = 1\nsubmit(counts[\"cable\"])\nsubmit(counts[\"washer\"])",
