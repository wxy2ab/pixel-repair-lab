  "topic": {
    "id": "tables",
    "order": 1,
    "title": {
      "zh": "数据表与列",
      "en": "Tables and columns"
    }
  },
  "title": {
    "zh": "给表格的每列起名字",
    "en": "Give Each Table Column a Name"
  },
  "brief": {
    "zh": "用 pandas 的 DataFrame 挑出需要的列和符合条件的行。",
    "en": "Use a pandas DataFrame to pick the columns and matching rows you need."
  },
  "concept": {
    "zh": "一行是一条记录，列名表示这条记录的哪一种信息。",
    "en": "A row is one record, and each named column holds one kind of information."
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "表格可以混合数据类型",
        "en": "A table can mix data types"
      },
      "body": {
        "zh": "DataFrame 的 id 和 day 列可以存数字，zone 列可以存区域名称。每行里的各列属于同一条测量记录。",
        "en": "A DataFrame can hold numbers in id and day and area names in zone. All columns in a row describe the same measurement."
      }
    },
    {
      "title": {
        "zh": "选行回答“哪些记录”",
        "en": "Select rows to answer “which records?”"
      },
      "body": {
        "zh": "df.loc[df['zone'] == 'hangar'] 只保留 zone 恰好是 hangar 的行。",
        "en": "df.loc[df['zone'] == 'hangar'] keeps rows whose zone exactly matches hangar."
      }
    },
    {
      "title": {
        "zh": "选列回答“要看什么”",
        "en": "Select columns to answer “what should I see?”"
      },
      "body": {
        "zh": "df[['zone', 'reading']] 保留每行的区域和读数。需要同时选行和列时，可以在同一次 .loc 操作中组合两个选择。",
        "en": "df[['zone', 'reading']] shows each row’s area and reading. Use .loc to combine row and column choices."
      }
    }
  ],
