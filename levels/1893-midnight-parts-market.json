  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "DIRS = [\"up\", \"right\", \"down\", \"left\"]\n\ndef magnitude(value):\n    if value < 0:\n        return -value\n    return value\n\ndef smaller(left, right):\n    if left < right:\n        return left\n    return right\n\ndef make_graph(board, width):\n    graph = {}\n    offsets = [-width, 1, width, -1]\n    for y in range(1, len(board) - 1):\n        for x in range(1, width - 1):\n            if board[y][x] != \".\":\n                continue\n            cell = y * width + x\n            edges = []\n            for direction in range(4):\n                neighbor = cell + offsets[direction]\n                if board[neighbor // width][neighbor % width] == \".\":\n                    edges.append([neighbor, DIRS[direction]])\n            graph[cell] = edges\n    return graph\n\ndef route_table(graph, cache, start):\n    if start in cache:\n        return cache[start]\n    table = {start: [0, None]}\n    queue = [start]\n    for cell in queue:\n        previous = table[cell]\n        for edge in graph[cell]:\n            neighbor = edge[0]\n            if neighbor in table:\n                continue\n            first = previous[1]\n            if first is None:\n                first = edge[1]\n            table[neighbor] = [previous[0] + 1, first]\n            queue.append(neighbor)\n    cache[start] = table\n    return table\n\ndef choose(state, graph, cache):\n    board = state[\"tiles\"]\n    width = len(board[0])\n    player = state[\"player\"]\n    start = player[1] * width + player[0]\n    rivals = state[\"opponents\"]\n    own_routes = route_table(graph, cache, start)\n    best_merit = -100000\n    action = \"wait\"\n    for item in state[\"items\"]:\n        cell = item[\"y\"] * width + item[\"x\"]\n        if cell == start:\n            return \"pick\"\n        if cell not in own_routes:\n            continue\n        distance = own_routes[cell][0]\n        direction = own_routes[cell][1]\n        safety = 4\n        for index in range(len(rivals)):\n            rival = rivals[index]\n            remaining = magnitude(item[\"x\"] - rival[\"x\"]) + magnitude(item[\"y\"] - rival[\"y\"])\n            if remaining < distance:\n                safety = smaller(safety, 0)\n            elif remaining == distance:\n                priority = (state[\"turn\"] + distance) % (len(rivals) + 1)\n                if priority > 0 and index + 1 >= priority:\n                    safety = smaller(safety, 1)\n                else:\n                    safety = smaller(safety, 3)\n        merit = safety * 20 - distance * 8\n        if merit > best_merit:\n            action = direction\n            best_merit = merit\n    return action\nboard = []\nwhile True:\n    state = scan()\n    if state[\"tiles\"] != board:\n        board = state[\"tiles\"]\n        graph = make_graph(board, len(board[0]))\n        cache = {}\n    action = choose(state, graph, cache)\n    if action == \"pick\":\n        pick()\n    elif action == \"wait\":\n        wait()\n    else:\n        move(action)\n",
