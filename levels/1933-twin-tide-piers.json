    { "id": "tide-log", "kind": "chest", "x": 7, "y": 4, "keyId": "ferry-key" }
  ],
  "objectives": [{ "type": "collect", "itemIds": ["tide-log"] }, { "type": "exit", "x": 10, "y": 5 }],
  "turnLimit": 22,
  "allowedApi": ["move", "wait", "pick"],
