  "concept": { "zh": "错拍双桥 · 钥匙 · 计时取件", "en": "Staggered pulses · Key · Timed pickup" },
  "brief": {
    "zh": "打开潮汐记录箱，在 22 回合内把航海日志送到南岸出口。钥匙藏在北桥上，踩到就能拿走。北桥从第 4 回合起每隔 4 回合亮起整行脉冲。南桥从第 2 回合起每隔 4 回合亮起整行脉冲。两桥之间的浮台在脉冲范围外。开箱要在箱子上用掉一回合。",
    "en": "Open the tide chest and bring the logbook to the south landing in 22 turns. Stepping on the key collects it. The north bridge pulses along its whole length on every fourth turn. The south bridge pulses every four turns starting on turn 2. The pontoons between the bridges are outside both beams. Opening the chest uses one turn on its tile."
  },
  "hints": [],
  "tiles": [
    "#############",
    "##.##########",
    "#...........#",
    "###..#..#..##",
    "##..........#",
    "##########.##",
    "#############"
  ],
  "start": { "x": 2, "y": 1 },
  "devices": [
    { "id": "high-tide", "kind": "cannon", "x": 1, "y": 2, "direction": "right", "period": 4 },
    { "id": "low-tide", "kind": "cannon", "x": 11, "y": 4, "direction": "left", "period": 4, "phase": 2 },
