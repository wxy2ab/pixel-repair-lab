  "cards": [
    {
      "id": "read-arrivals",
      "label": {
        "zh": "读取到货顺序",
        "en": "Read arrivals"
      },
      "template": "arrivals = scan()"
    },
    {
      "id": "new-cargo",
      "label": {
        "zh": "建一个空列表",
        "en": "Make an empty list"
      },
      "template": "cargo = []"
    },
    {
      "id": "each-arrival",
      "label": {
        "zh": "逐件查看到货",
        "en": "For each arrival"
      },
      "template": "for box in arrivals:",
      "block": true
    },
    {
      "id": "add-cargo",
      "label": {
        "zh": "把货箱放到末尾",
        "en": "Append the box"
      },
      "template": "cargo.append(box)"
    },
    {
      "id": "each-cargo",
      "label": {
        "zh": "有几箱就发几次",
        "en": "Send once per box"
      },
      "template": "for turn in range(len(cargo)):",
      "block": true
    },
    {
      "id": "send-cargo",
      "label": {
        "zh": "取一箱并发送",
        "en": "Remove and send a box"
      },
      "template": "submit(cargo.{{take}})",
      "parameters": [
        {
          "name": "take",
          "label": {
            "zh": "从哪一端取",
            "en": "Which end"
          },
          "choices": [
            {
              "id": "last",
              "label": {
                "zh": "末尾",
                "en": "Last"
              },
              "code": "pop()"
            },
            {
              "id": "first",
              "label": {
                "zh": "开头",
                "en": "First"
              },
              "code": "pop(0)"
            }
          ]
        }
      ]
    },
    {
      "id": "move",
      "label": {
        "zh": "移动",
        "en": "Move"
      },
      "template": "move({{direction}})",
      "parameters": [
