  "stage": "exercise",
  "title": {
    "zh": "先来的先发货",
    "en": "First in Line"
  },
  "concept": {
    "zh": "队列与先进先出",
    "en": "Queues and first in, first out"
  },
  "brief": {
    "zh": "货箱按到达顺序排队。依次发完所有货箱，再沿中间的通道到出口。巡逻机器人会在上方通道来回巡视。",
    "en": "Queue the boxes in arrival order. Send every box in turn, then take the middle passage to the exit. A guard bot patrols the upper passage."
  },
  "hints": [
    {
      "zh": "用 append() 把后来者接到队尾。哪一个索引对应队伍最前面？",
      "en": "Use append() to add each arrival to the back. Which index is at the front of the queue?"
    },
    {
      "zh": "pop(0) 取走队伍最前面的货箱。发完货后，从中间通道向右到出口。",
      "en": "pop(0) removes the box at the front. After sending the boxes, go right along the middle passage to the exit."
    }
  ],
  "tiles": [
    "#########",
    "#.......#",
    "#.##.##.#",
    "#.......#",
    "#.#...#.#",
    "#.......#",
    "#########"
  ],
