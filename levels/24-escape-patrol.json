  "starterCode": "from algorithms import shortest_step\n\nstate = scan()\ngoal = state[\"exit\"]\n",
  "solutionCode": "from algorithms import shortest_step\n\nwhile True:\n    state = scan()\n    goal = state[\"exit\"]\n    if len(state[\"items\"]) > 0:\n        part = state[\"items\"][0]\n        goal = [part[\"x\"], part[\"y\"]]\n    if state[\"player\"] == goal:\n        pick()\n    else:\n        tiles = []\n        for row in state[\"tiles\"]:\n            cells = []\n            for tile in row:\n                cells.append(tile)\n            tiles.append(cells)\n        for rival in state[\"opponents\"]:\n            tiles[rival[\"y\"]][rival[\"x\"]] = \"#\"\n        direction = shortest_step(tiles, state[\"player\"], goal)\n        if direction is None:\n            wait()\n        else:\n            move(direction)",
