  "topic": { "id": "center-spread", "order": 1, "title": { "zh": "平均值、中位数与极差", "en": "Mean, median, and range" } },
  "title": { "zh": "读懂平均值和中位数", "en": "Read the Mean and Median" },
  "brief": { "zh": "观察一个特别高的温度值会改变哪些统计量。", "en": "See which statistics change when one temperature rises sharply." },
  "concept": { "zh": "平均值看总量，中位数看排序后的中间位置", "en": "The mean uses the total, the median uses the middle position" },
  "hints": [],
  "sections": [
    { "title": { "zh": "平均值", "en": "Mean" }, "body": { "zh": "把温度读数加起来，再除以读数的个数，就得到平均值。每一个读数都会影响总和。", "en": "Add the temperatures and divide by the number of readings. Every reading contributes to the total." } },
    { "title": { "zh": "中位数和极差", "en": "Median and range" }, "body": { "zh": "把读数从低到高排列。奇数个样本取正中间的值，偶数个取中间两个值的平均。最高值减最低值是极差。", "en": "Sort the readings. For an odd sample size, take the middle reading. For an even sample size, average the two middle readings. Subtract the lowest reading from the highest for the range." } }
  ],
  "animation": {
