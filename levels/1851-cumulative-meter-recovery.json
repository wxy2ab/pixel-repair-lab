    "STORE",
    "HALT"
  ],
  "starterCode": "HALT\n",
  "solutionCode": "LOAD 3\nSUB 2\nSTORE 3\nLOAD 2\nSUB 1\nSTORE 2\nLOAD 1\nSUB 0\nSTORE 1\nADD 0\nADD 2\nADD 3\nHALT\n",
