{
  "version": 1,
  "kind": "grid",
  "id": "challenge-darkroom-shutter",
  "order": 1927,
  "difficulty": "intermediate",
  "unit": {"id": "challenge-zone", "order": 90, "title": {"zh": "挑战场", "en": "Challenge Arena"}},
  "stage": "challenge",
  "prerequisites": [{"unit": "foundations", "topic": "sequence"}, {"unit": "python-intermediate", "topic": "for-loops"}],
  "title": {"zh": "暗房里的胶卷", "en": "The Darkroom Shutter"},
  "concept": {"zh": "反射光路 · 联动闸门", "en": "Reflected beam · Linked shutters"},
  "brief": {
    "zh": "从暗房的宝箱里取出胶卷，带到出口。地板开关会同时升起出口门和挡光闸。闭合的闸门能挡住镜子折来的激光。回合结束时站在光束里就会停机。最多用 20 回合。",
    "en": "Take the film from the darkroom chest and bring it to the exit. The floor switch raises both the exit gate and the light shutter. A closed shutter stops the reflected beam. Ending a turn in the beam shuts Sprout down. You have 20 turns."
  },
  "hints": [],
  "tiles": ["##########", "#....#####", "####.#####", "####.#####", "#........#", "#.####.###", "#......###", "##########"],
  "start": {"x": 1, "y": 4},
  "turnLimit": 20,
  "allowedApi": ["move", "pick"],
  "devices": [
    {"kind": "laser", "id": "safelight", "x": 1, "y": 1, "direction": "right"},
    {"kind": "mirror", "id": "darkroom-mirror", "x": 4, "y": 1, "orientation": "\\"},
    {"kind": "door", "id": "light-shutter", "x": 4, "y": 3, "switchId": "release"},
    {"kind": "chest", "id": "film-reel", "x": 4, "y": 4},
    {"kind": "door", "id": "dock-hatch", "x": 7, "y": 4, "switchId": "release"},
    {"kind": "switch", "id": "release", "x": 3, "y": 6}
  ],
  "objectives": [{"type": "collect", "itemIds": ["film-reel"]}, {"type": "exit", "x": 8, "y": 4}],
  "cards": [
    {"id": "up", "label": {"zh": "向上", "en": "Move up"}, "template": "move(\"up\")"},
    {"id": "right", "label": {"zh": "向右", "en": "Move right"}, "template": "move(\"right\")"},
    {"id": "down", "label": {"zh": "向下", "en": "Move down"}, "template": "move(\"down\")"},
    {"id": "left", "label": {"zh": "向左", "en": "Move left"}, "template": "move(\"left\")"},
    {"id": "pick", "label": {"zh": "打开脚下的宝箱", "en": "Open this chest"}, "template": "pick()"},
    {
      "id": "repeat",
      "label": {"zh": "重复几次", "en": "Repeat moves"},
      "template": "for step in range({{count}}):",
      "block": true,
      "parameters": [
        {
          "name": "count",
          "label": {"zh": "次数", "en": "Times"},
          "choices": [
            {"id": "n2", "label": {"zh": "2", "en": "2"}, "code": "2"},
            {"id": "n3", "label": {"zh": "3", "en": "3"}, "code": "3"},
            {"id": "n4", "label": {"zh": "4", "en": "4"}, "code": "4"},
            {"id": "n5", "label": {"zh": "5", "en": "5"}, "code": "5"},
            {"id": "n6", "label": {"zh": "6", "en": "6"}, "code": "6"}
          ]
        }
      ]
    }
  ],
  "solutionCards": [
    {"cardId": "repeat", "values": {"count": "n3"}, "children": [{"cardId": "right"}]},
    {"cardId": "pick"},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "right"}]},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "down"}]},
    {"cardId": "repeat", "values": {"count": "n3"}, "children": [{"cardId": "left"}]},
    {"cardId": "repeat", "values": {"count": "n3"}, "children": [{"cardId": "right"}]},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "up"}]},
    {"cardId": "repeat", "values": {"count": "n2"}, "children": [{"cardId": "right"}]}
  ]
