  ],
  "cards": [
    {
      "id": "read-route",
      "label": {
        "zh": "扫描并保存路线列表",
        "en": "Scan and save the route list"
      },
      "template": "route = scan()"
    },
    {
      "id": "each-index",
      "label": {
        "zh": "逐个查看列表索引",
        "en": "For each list index"
      },
      "template": "for i in range(len(route)):",
      "block": true
    },
    {
      "id": "indexed-move",
      "label": {
        "zh": "读取索引 i 的方向并移动",
        "en": "Move in the direction at index i"
      },
      "template": "move(route[i])"
    },
    {
      "id": "move",
      "label": {
        "zh": "移动",
        "en": "Move"
      },
      "template": "move({{direction}})",
      "parameters": [
        {
          "name": "direction",
          "label": {
            "zh": "方向",
            "en": "Direction"
          },
          "choices": [
            {
              "id": "right",
