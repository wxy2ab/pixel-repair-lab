  "tutorial": [
    {
      "text": {
        "zh": "添加「扫描并保存路线列表」。机器人会把站台给出的方向放进 route。",
        "en": "Add Scan and Save the Route List. Sprout puts the directions from the station into route."
      },
      "target": "palette"
    },
    {
      "text": {
        "zh": "添加「逐个查看列表索引」。循环中的 i 会从 0 开始往后数。",
        "en": "Add For Each List Index. Inside the loop, i starts counting from 0."
      },
      "target": "program"
    },
    {
      "text": {
        "zh": "把「读取索引 i 的方向并移动」放进循环，让每个方向都用一次。",
        "en": "Put Move in the Direction at Index i inside the loop to use each direction once."
      },
      "target": "program"
    },
    {
      "text": {
        "zh": "点击「运行」。同一程序也会验证一条不同长度的路线。",
        "en": "Click Run. Your program is also checked against a route of a different length."
      },
      "target": "run"
    }
  ]
}
