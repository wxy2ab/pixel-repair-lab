  "stage": "exercise",
  "title": {
    "zh": "把路线装进口袋",
    "en": "Pocket a Route"
  },
  "concept": {
    "zh": "列表与索引",
    "en": "Lists and indexing"
  },
  "brief": {
    "zh": "站台提供一份方向列表。按索引读出每个方向，再用它移动。程序还要能走另一条路线。",
    "en": "The station supplies a list of directions. Read each direction by its index and use it to move. Your program should work on a second route too."
  },
  "hints": [
    {
      "zh": "用 scan() 把路线存到 route。列表的第一个索引是 0。",
      "en": "Use scan() to save the route in route. The first list index is 0."
    },
    {
      "zh": "range(len(route)) 依次给出每个索引。把 move(route[i]) 放进循环。",
      "en": "range(len(route)) gives you each index in order. Put move(route[i]) inside the loop."
    }
  ],
  "tiles": [
    "#########",
    "#......##",
    "#....#..#",
    "#.#.....#",
    "#....#..#",
    "#.......#",
    "#########"
  ],
  "start": {
    "x": 2,
    "y": 5
  },
  "input": [
    "right",
    "right",
    "up",
    "up",
    "right"
  ],
  "allowedApi": [
    "move",
    "scan",
    "say"
  ],
  "objectives": [
