                "en": "Up"
              },
              "code": "\"up\""
            },
            {
              "id": "left",
              "label": {
                "zh": "左",
                "en": "Left"
              },
              "code": "\"left\""
            },
            {
              "id": "down",
              "label": {
                "zh": "下",
                "en": "Down"
              },
              "code": "\"down\""
            }
          ]
        }
      ]
    }
  ],
  "solutionCards": [
