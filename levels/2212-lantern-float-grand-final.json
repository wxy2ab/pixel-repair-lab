  "starterCode": "state = scan()\n",
  "solutionCode": "def visible_pulse(state):\n    for ray in [[\"up\", 0, -1], [\"right\", 1, 0], [\"down\", 0, 1], [\"left\", -1, 0]]:\n        x = state[\"player\"][0]\n        y = state[\"player\"][1]\n        for distance in range(state[\"range\"]):\n            x += ray[1]\n            y += ray[2]\n            if state[\"tiles\"][y][x] == \"#\":\n                break\n            for bot in state[\"opponents\"]:\n                if bot[\"hp\"] > 0 and bot[\"x\"] == x and bot[\"y\"] == y:\n                    return ray[0]\n    return None\n\ndef clear_view():\n    direction = visible_pulse(scan())\n    while direction is not None:\n        shoot(direction)\n        direction = visible_pulse(scan())\n\ndef visit(x, y):\n    while scan()[\"player\"] != [x, y]:\n        clear_view()\n        player = scan()[\"player\"]\n        if player[0] < x:\n            move(\"right\")\n        elif player[0] > x:\n            move(\"left\")\n        elif player[1] < y:\n            move(\"down\")\n        else:\n            move(\"up\")\n\ndef wait_until(turn):\n    while scan()[\"turn\"] < turn:\n        direction = visible_pulse(scan())\n        if direction is None:\n            guard()\n        else:\n            shoot(direction)\n\nvisit(3, 10)\npick()\nvisit(4, 10)\npick()\nvisit(4, 9)\npick()\nvisit(3, 9)\npick()\nvisit(4, 9)\nvisit(4, 8)\npick()\nwait_until(8)\nlane = 10\nif scan()[\"tiles\"][10][6] == \"#\":\n    lane = 8\nvisit(4, lane)\nvisit(8, lane)\nvisit(8, 9)\nvisit(10, 9)\nwait_until(16)\npick()\nvisit(10, 8)\npick()\nvisit(10, 4)\nvisit(13, 4)\nvisit(13, 3)\nvisit(16, 3)\nclear_view()\n",
