      "operation": "query",
      "input": "clean",
      "label": {
        "zh": "车间候选记录",
        "en": "Workshop candidates"
      },
      "prompt": {
        "zh": "用 SQL 取 24°C 及以上的车间记录，只留编号和温度，温度从低到高。",
        "en": "Use SQL to select workshop readings at 24°C or above. Return ID and temperature, coldest first."
      },
      "initial": {
        "columns": "all",
        "zone": "all",
        "minimum": 23,
        "sort": "id"
      },
      "goal": {
