  "sections": [
    {
      "title": {
        "zh": "下一条指令用到上一步的结果",
        "en": "The next command uses a result from an earlier step"
      },
      "body": {
        "zh": "补电先要读到起始电量。屏幕要显示的是补电后的电量，所以要等程序把新电量算好。",
        "en": "To add charge, the program needs the starting charge. The screen shows the new charge, so the program must calculate it first."
      }
    },
    {
      "title": {
        "zh": "从卡住的地方往前找",
        "en": "Look back from where the program stopped"
      },
      "body": {
        "zh": "显示在补电前面时，起始电量已经读到了，存新电量的变量却还没有值。把补电那一步移到显示之前，再运行一次。",
        "en": "If display comes before charging, the program has read the starting charge, but it has no new charge yet. Move charging before display and run again."
      }
    }
  ],
  "question": {
    "prompt": {
      "zh": "已经读过电量，为什么接着显示会卡住？",
      "en": "The program has read the starting charge. Why does it stop if it tries to display next?"
    },
    "options": [
      {
        "zh": "还没有算出补电后的电量。",
        "en": "It has not calculated the new charge yet."
      },
      {
        "zh": "没有读到起始电量。",
        "en": "It did not read the starting charge."
      },
      {
        "zh": "应该把屏幕放在第一步。",
        "en": "The display should come first."
      }
    ],
    "correct": 0,
    "feedback": {
      "zh": "读取给了程序原电量，补电才会产生要显示的新电量。",
      "en": "Reading gives the program its starting charge. Charging produces the new charge for the display."
    }
  },
