  "title": {
    "zh": "恒温带内的值班日",
    "en": "Days Inside the Thermostat Band"
  },
  "brief": {
    "zh": "恒温器只认 20 到 28°C 的读数，两个端点都算。用已清洗记录提交两次边界筛选的底稿，再从有效样本中挑出日平均至少 24°C 的日期，最暖的排在前面。",
    "en": "The thermostat accepts readings from 20 through 28°C, including both limits. Submit a trail for both bounds, then rank days whose in-band readings average at least 24°C, warmest first."
  },
  "concept": {
    "zh": "双边筛选、分日平均与验收排序",
    "en": "Inclusive limits, daily averages and acceptance ranking"
  },
  "prerequisites": [
    {
      "unit": "numpy",
      "topic": "masks"
    },
    {
      "unit": "statistics",
      "topic": "grouped-summary"
    },
    {
      "unit": "database",
      "topic": "sql-groups"
    }
  ],
  "hints": [],
