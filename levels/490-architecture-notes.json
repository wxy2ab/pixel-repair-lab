  "stage": "explain",
  "title": {
    "zh": "打开 CPU 的维修盖",
    "en": "Open the CPU Service Panel"
  },
  "concept": {
    "zh": "地址指向存放位置，LOAD 读值，STORE 改值。",
    "en": "An address names a storage location. LOAD reads its value and STORE writes it."
  },
  "brief": {
    "zh": "内存有一排带编号的格子。观察一次读取和一次写入怎样改变格子里的数。",
    "en": "Memory is a row of numbered cells. Follow a read and a write to see what happens to their values."
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "编号和数值是两件事",
        "en": "Addresses and values are different"
      },
      "body": {
        "zh": "把这一排内存想成杯架。地址 1 就像杯位上的 1 号牌。执行 LOAD 1 时，沿着编号找到格子，把里面的数读进累加器。",
        "en": "Picture the row of memory cells as a cup rack. Address 1 is like the number under spot 1. LOAD 1 finds that spot and reads the number inside into the accumulator."
      }
    },
    {
      "title": {
        "zh": "读取是复制，写入会替换",
        "en": "A read copies, a write replaces"
      },
      "body": {
        "zh": "LOAD 把内存里的数复制到累加器，原格子保留原值。STORE 把累加器当前的值写入目标地址，替换原先的值。",
        "en": "LOAD copies a value into the accumulator and leaves the memory cell as it was. STORE copies the accumulator into the target cell, replacing its previous value."
      }
    }
  ],
  "question": {
    "prompt": {
      "zh": "地址 1 里是 3，地址 2 里是 9。先 LOAD 1，再 STORE 2，最后地址 2 里的值是什么？",
      "en": "Address 1 holds 3 and address 2 holds 9. After LOAD 1 and then STORE 2, what does address 2 hold?"
    },
    "options": [
      {
        "zh": "1",
        "en": "1"
      },
      {
        "zh": "3",
        "en": "3"
      },
      {
        "zh": "9",
        "en": "9"
      }
    ],
    "correct": 1,
    "feedback": {
      "zh": "LOAD 1 把 3 复制到 ACC。STORE 2 把 ACC 的 3 写到地址 2。",
      "en": "LOAD 1 copies 3 into ACC. STORE 2 copies that 3 into address 2."
    }
  },
