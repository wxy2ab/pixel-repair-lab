  "brief": {
    "zh": "实现 needs_repair(reading, limit)。读数达到或超过警戒线时返回 True，其余情况返回 False。通过用例后可以保存这个函数。",
    "en": "Implement needs_repair(reading, limit). Return True when the reading meets or exceeds the limit, and False otherwise. Pass the cases to save the function."
  },
  "hints": [
    {
      "zh": "用 >= 把相等也包括进来。比较表达式本身就能得到 True 或 False。",
      "en": "Use >= so equality counts. The comparison itself produces True or False."
    }
  ],
  "functionName": "needs_repair",
  "starterCode": "def needs_repair(reading, limit):\n    return False\n",
  "solutionCode": "def needs_repair(reading, limit):\n    return reading >= limit\n",
