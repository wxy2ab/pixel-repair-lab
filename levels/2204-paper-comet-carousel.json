  "starterCode": "state = scan()\n",
  "solutionCode": "move(\"up\")\npick()\nwhile True:\n    state = scan()\n    x = state[\"player\"][0]\n    y = state[\"player\"][1]\n    reach = state[\"range\"]\n    aim = \"\"\n    for rival in state[\"opponents\"]:\n        dx = rival[\"x\"] - x\n        dy = rival[\"y\"] - y\n        if rival[\"hp\"] > 0:\n            if dx == 0 and dy >= -reach and dy <= reach:\n                if dy < 0:\n                    aim = \"up\"\n                else:\n                    aim = \"down\"\n                break\n            if dy == 0 and dx >= -reach and dx <= reach:\n                if dx < 0:\n                    aim = \"left\"\n                else:\n                    aim = \"right\"\n                break\n    if aim:\n        shoot(aim)\n    else:\n        guard()\n",
