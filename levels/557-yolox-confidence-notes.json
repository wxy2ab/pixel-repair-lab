  },
  "topic": {
    "id": "detection-confidence",
    "order": 3,
    "title": {
      "zh": "置信度门槛",
      "en": "Confidence thresholds"
    }
  },
  "title": {
    "zh": "设一个合适的置信度门槛",
    "en": "Choose a Confidence Threshold"
  },
  "brief": {
    "zh": "看门槛怎样改变候选清单，想一想什么时候宁可多复核几个框。",
    "en": "See how the threshold changes the candidate list, and when it is worth checking a few extra boxes."
  },
  "concept": {
    "zh": "提高置信度门槛会减少低分预测，也可能漏掉真实但难认的目标。",
    "en": "A higher threshold removes lower-scoring predictions and can also hide real objects that are hard to recognize."
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "分数来自模型",
        "en": "Scores come from the model"
      },
      "body": {
        "zh": "YOLOX 给每个候选一个分数。高分表示模型对这个候选更有把握，现场核对才知道它是否猜对。调节门槛会改变要显示的预测。",
        "en": "YOLOX gives each prediction a score. A higher score means the model is more confident about the candidate. Looking at the photo tells you whether its guess was right. The threshold selects which predictions to show."
      }
    },
    {
      "title": {
        "zh": "根据用途选择门槛",
        "en": "Match the threshold to the job"
      },
      "body": {
        "zh": "如果每个框都要由人复核，降低门槛能把难认目标也交给人看。提高门槛会缩短清单，同时也可能漏掉确实存在的物体。",
        "en": "When a person checks every box, a lower threshold can surface harder-to-spot objects for review. A higher threshold gives a shorter list and can also miss objects that are actually present."
      }
    }
  ],
