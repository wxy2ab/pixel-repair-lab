  "topic": {
    "id": "object-detection",
    "order": 1,
    "title": {
      "zh": "目标检测",
      "en": "Object detection"
    }
  },
  "title": {
    "zh": "照片里有什么，在哪里？",
    "en": "What Is in the Photo, and Where?"
  },
  "brief": {
    "zh": "跟着一张照片，看看像素是怎样变成可以核对的预测。",
    "en": "Follow a photo as its pixels become predictions you can check."
  },
  "concept": {
    "zh": "目标检测给每个候选物体预测类别、位置和分数。",
    "en": "Object detection predicts a class, location, and score for each candidate object."
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "一张图可以有多个答案",
        "en": "One image can have several answers"
      },
      "body": {
        "zh": "只回答“这是一张有狗的照片”是图像分类。目标检测还会指出狗在哪儿。同一张图的每个候选对象可以有各自的类别和框。",
        "en": "Answering only ‘this photo contains a dog’ is image classification. Object detection also says where the dog is. Each candidate object can have its own class and box."
      }
    },
    {
      "title": {
        "zh": "先用眼睛核对",
        "en": "Check the image yourself"
      },
      "body": {
        "zh": "光线、遮挡、大小和拍摄角度都会影响预测。模型可能漏掉物体，也可能把物体认错。看原图和模型的框，才能发现这些情况。",
        "en": "Lighting, occlusion, size, and camera angle can affect predictions. The model can miss an object or give it the wrong label. Compare its boxes with the original photo to notice these cases."
      }
    }
  ],
