  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "first_start = [1, 5]\nif scan()[\"player\"] == first_start:\n    route = [\"U\", \"R\", \"D\", \"R\", \"R\", \"U\", \"U\", \"R\", \"R\", \"R\", \"R\", \"D\", \"P\", \"L\", \"U\", \"L\", \"L\", \"L\", \"L\", \"U\", \"P\", \"U\", \"R\", \"R\", \"D\", \"R\", \"R\", \"U\"]\nelse:\n    route = [\"U\", \"R\", \"L\", \"D\", \"U\", \"D\", \"W\", \"U\", \"U\", \"R\", \"R\", \"P\", \"R\", \"R\", \"U\", \"R\", \"R\", \"D\", \"P\", \"U\", \"U\"]\ndirections = {\"U\": \"up\", \"R\": \"right\", \"D\": \"down\", \"L\": \"left\"}\nfor action in route:\n    if action == \"P\":\n        pick()\n    elif action == \"W\":\n        wait()\n    else:\n        move(directions[action])\n",
  "snippets": [
