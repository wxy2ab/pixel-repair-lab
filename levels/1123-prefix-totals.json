  "title": {
    "zh": "建立一张累计表",
    "en": "Build a prefix table"
  },
  "brief": {
    "zh": "编写 prefix_totals(values)，返回从 0 到全部元素的每个累计值。",
    "en": "Write prefix_totals(values) and return every cumulative total, starting with zero."
  },
  "concept": {
    "zh": "使用循环保存中间结果",
    "en": "Store intermediate results"
  },
  "hints": [],
  "functionName": "prefix_totals",
  "starterCode": "def prefix_totals(values):\n    prefix = [0]\n    total = 0\n    return prefix",
  "solutionCode": "def prefix_totals(values):\n    prefix = [0]\n    total = 0\n    for value in values:\n        total += value\n        prefix.append(total)\n    return prefix",
  "snippets": [
    {
      "label": {
        "zh": "循环累加和保存",
        "en": "Accumulate and store"
      },
      "code": "    for value in values:\n        total += value\n        prefix.append(total)"
    }
  ],
  "cases": [
    {
      "args": [
        [
          2,
          3,
          5
        ]
      ],
      "expected": [
        0,
        2,
        5,
        10
      ]
    },
    {
      "args": [
        [
          -2,
          4,
          -1
        ]
      ],
      "expected": [
        0,
        -2,
        2,
        1
      ]
    },
    {
      "args": [
        []
      ],
      "expected": [
