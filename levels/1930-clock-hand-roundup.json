  "concept": { "zh": "环形小路 · 双箱归位", "en": "Loop shortcut · Two chests" },
  "brief": {
    "zh": "从两个零件箱取出钟针，带回中央钟轴。西翼的钥匙配北侧锁门。北侧踏板能切断东翼的激光。开一个箱子用一回合。钟轴将在第 21 回合结束时停转。",
    "en": "Recover both clock hands and return to the central spindle. The west key fits the north door. The north plate cuts power to the east laser. Opening each chest costs one turn. The spindle stops at the end of turn 21."
  },
  "hints": [],
  "tiles": [
    "#########",
    "####.####",
    "#....####",
    "#.##.#.##",
    "#.......#",
    "#########"
  ],
  "start": { "x": 4, "y": 4 },
  "turnLimit": 21,
  "allowedApi": ["move", "pick"],
  "devices": [
    { "kind": "key", "id": "clock-key", "x": 1, "y": 4 },
    { "kind": "door", "id": "clock-door", "x": 4, "y": 2, "keyId": "clock-key" },
    { "kind": "switch", "id": "east-cutoff", "x": 4, "y": 1 },
    { "kind": "laser", "id": "east-beam", "x": 6, "y": 3, "direction": "down", "switchId": "east-cutoff" },
    { "kind": "chest", "id": "minute-hand", "x": 1, "y": 3, "keyId": "clock-key" },
    { "kind": "chest", "id": "hour-hand", "x": 7, "y": 4 }
  ],
  "objectives": [
