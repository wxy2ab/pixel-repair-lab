    "zh": "记忆储物柜",
    "en": "Memory Lockers"
  },
  "concept": {
    "zh": "内存地址与读写",
    "en": "Memory addresses, reads, and writes"
  },
  "brief": {
    "zh": "读取地址 1 和 2 里的数字，把它们相加。把结果写入地址 3，再从地址 3 读出并提交。",
    "en": "Read the numbers at addresses 1 and 2 and add them. Write the result to address 3, then read it back and submit it."
  },
  "hints": [
    {
      "zh": "地址像柜子的编号。load(1) 取出 1 号柜里的值。",
      "en": "An address is like a locker number. load(1) reads the value stored in locker 1."
    },
    {
      "zh": "store() 的第一个参数是地址，第二个参数是要存进去的值。",
      "en": "The first argument to store() is the address. The second is the value to put there."
    }
  ],
