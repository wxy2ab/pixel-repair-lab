  },
  "hints": [],
  "mode": "grid",
  "examples": [
    {
      "title": {
        "zh": "从第 1 箱到第 3 箱之前",
        "en": "From index 1 to before 3"
      },
      "source": "plan = scan()\nprefix = [0]\nrunning = 0\nfor value in plan[\"weights\"]:\n    running += value\n    prefix.append(running)\n    say(str(prefix))\nsubmit(prefix[plan[\"end\"]] - prefix[plan[\"start\"]])",
      "scenario": {
        "tiles": [
          "#####",
          "#...#",
          "#####"
        ],
        "start": {
          "x": 1,
          "y": 1
        },
        "input": {
