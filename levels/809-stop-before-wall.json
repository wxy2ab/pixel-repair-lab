  "cards": [
    {
      "id": "while-clear",
      "label": {
        "zh": "重复检查右侧",
        "en": "Keep checking the right side"
      },
      "template": "while scan()[\"right\"] {{condition}} \"wall\":",
      "block": true,
      "parameters": [
        {
          "name": "condition",
          "label": {
            "zh": "什么时候继续",
            "en": "When to continue"
          },
          "choices": [
            {
              "id": "equals",
              "label": {
                "zh": "看到墙",
                "en": "When there is a wall"
              },
              "code": "=="
            },
            {
              "id": "not-equals",
              "label": {
                "zh": "前方还没遇墙",
                "en": "Until a wall"
              },
              "code": "!="
            }
          ]
        }
      ]
    },
    {
      "id": "right",
      "label": {
        "zh": "向右移动一格",
        "en": "Move one tile right"
      },
      "template": "move(\"right\")"
    }
