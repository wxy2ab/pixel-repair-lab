  "title": {
    "zh": "列表与字典",
    "en": "Lists and dictionaries"
  },
  "concept": {
    "zh": "列表索引与字典键",
    "en": "List indexes and dictionary keys"
  },
  "brief": {
    "zh": "从一排电池里取电量，再按电池名字找到并更新它的补电记录。",
    "en": "Read a charge from a row of batteries, then find a battery by name and update its record."
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "按位置取电量",
        "en": "Read by position"
      },
      "body": {
        "zh": "列表把电量按顺序存放。索引从 0 开始，所以 batteries[1] 取第 2 块电池的电量。",
        "en": "A list stores charges in order. Indexes start at 0, so batteries[1] reads the second battery’s charge."
      }
    },
    {
      "title": {
        "zh": "按名字查电量",
        "en": "Look up a charge by name"
      },
      "body": {
        "zh": "给每块电池贴上名字后，就能把名字用作字典的键。records[\"B\"] 找到 B 号电池的电量。",
        "en": "Give each battery a name and use each name as a dictionary key. records[\"B\"] finds battery B’s charge."
      }
    },
    {
      "title": {
        "zh": "更新一条记录",
        "en": "Update one record"
      },
      "body": {
        "zh": "把查到的电量加 3，再写回键 \"B\"。其余电池的记录仍保留原来的电量。",
        "en": "Add 3 to the charge you looked up and save it back under \"B\". The other records keep their original charges."
      }
    }
  ],
  "question": {
    "prompt": {
      "zh": "B 号电池现在有 6 格。补 3 格后，哪句代码会把 9 格记到 B 名下？",
      "en": "Battery B has 6 units. After adding 3, which line stores 9 under B?"
    },
    "options": [
      {
        "zh": "records[\"B\"] = 9",
        "en": "records[\"B\"] = 9"
      },
      {
        "zh": "batteries[1] = 9",
        "en": "batteries[1] = 9"
      },
      {
        "zh": "records[\"C\"] = 9",
        "en": "records[\"C\"] = 9"
      }
    ],
    "correct": 0,
    "feedback": {
      "zh": "字典用键决定更新哪一条。键 \"B\" 对应 B 号电池。",
      "en": "The key selects which dictionary record to update. The key \"B\" belongs to battery B."
    }
  },
