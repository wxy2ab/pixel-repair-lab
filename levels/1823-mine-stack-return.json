  "cards": [
    {
      "id": "read",
      "label": {
        "zh": "读入去程",
        "en": "Read the outward path"
      },
      "template": "outward = scan()"
    },
    {
      "id": "stack",
      "label": {
        "zh": "建一个空栈",
        "en": "Create an empty stack"
      },
      "template": "trail = []"
    },
    {
      "id": "opposites",
      "label": {
        "zh": "建立方向反查表",
        "en": "Create opposite-direction lookup"
      },
      "template": "opposite = {\"up\": \"down\", \"right\": \"left\", \"down\": \"up\", \"left\": \"right\"}"
    },
    {
      "id": "outward",
      "label": {
        "zh": "逐个执行去程方向",
        "en": "Follow each outward direction"
      },
      "template": "for direction in outward:",
      "block": true
    },
    {
      "id": "travel",
      "label": {
        "zh": "按记录的方向移动",
        "en": "Move in the recorded direction"
      },
      "template": "move(direction)"
    },
    {
      "id": "remember-same",
      "label": {
        "zh": "把当前方向压栈",
        "en": "Push the current direction"
      },
      "template": "trail.append(direction)"
    },
    {
      "id": "remember-inverse",
      "label": {
        "zh": "把相反方向压栈",
        "en": "Push the opposite direction"
      },
      "template": "trail.append(opposite[direction])"
    },
    {
      "id": "pick",
      "label": {
        "zh": "拾取零件",
        "en": "Pick up the part"
      },
      "template": "pick()"
    },
    {
      "id": "while-trail",
      "label": {
        "zh": "只要栈里还有记录",
        "en": "While the stack still has entries"
      },
      "template": "while trail:",
      "block": true
    },
    {
      "id": "pop-trail",
      "label": {
        "zh": "弹出栈顶方向",
        "en": "Pop the top direction"
      },
      "template": "direction = trail.pop()"
    },
    {
      "id": "submit-step",
      "label": {
        "zh": "提交移动方向",
        "en": "Submit the move direction"
      },
      "template": "submit(direction)"
    }
  ],
