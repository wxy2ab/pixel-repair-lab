{
  "version": 1,
  "id": "challenge-clockwork-encore",
  "order": 1935,
  "kind": "grid",
  "difficulty": "advanced",
  "unit": { "id": "challenge-zone", "order": 90, "title": { "zh": "挑战场", "en": "Challenge Arena" } },
  "stage": "challenge",
  "prerequisites": [{ "unit": "python-intermediate", "topic": "for-loops" }, { "unit": "routing", "topic": "breadth-first" }],
  "title": { "zh": "发条剧院的返场曲", "en": "Encore at the Clockwork Theatre" },
  "concept": { "zh": "换景门 · 定时礼花 · 自动琴纸带", "en": "Scenery doors · Confetti cue · Player-piano roll" },
  "brief": {
    "zh": "从道具箱取出自动琴的纸带，在 30 回合内送到西侧出口。楼上的钥匙会立刻解开两道换景门和道具箱。关着的换景门能挡住舞台激光。后台地板上的开关会切断激光。东梯旁的礼花只在第 9 回合喷出，覆盖本格和相邻四格。南廊的脉冲炮从第 4 回合起每隔 4 回合扫过整条走廊。开箱用一回合。",
    "en": "Fetch the player-piano roll from the prop chest and bring it to the west exit in 30 turns. The upstairs key immediately unlocks both scenery doors and the prop chest. A closed scenery door blocks the stage laser. The backstage floor switch cuts power to the laser. Confetti bursts beside the east stairs on turn 9 only, covering its tile and the four neighboring tiles. The south hall cannon sweeps the entire corridor every four turns starting on turn 4. Opening the chest takes one turn."
  },
  "hints": [],
  "tiles": [
    "#############",
    "#####......##",
    "#####.####.##",
    "#........#..#",
    "##.####.##.##",
    "##.####.....#",
    "##.#####.####",
    "#############"
  ],
  "start": { "x": 5, "y": 3 },
  "devices": [
    { "id": "stage-laser", "kind": "laser", "x": 1, "y": 3, "direction": "right", "switchId": "backstage-relay" },
    { "id": "scenery-door", "kind": "door", "x": 3, "y": 3, "keyId": "prop-key" },
    { "id": "prop-key", "kind": "key", "x": 8, "y": 1 },
    { "id": "backstage-relay", "kind": "switch", "x": 8, "y": 6 },
    { "id": "piano-roll", "kind": "chest", "x": 2, "y": 5, "keyId": "prop-key" },
    { "id": "wing-pulse", "kind": "cannon", "x": 11, "y": 5, "direction": "left", "period": 4, "phase": 0 },
    { "id": "wing-door", "kind": "door", "x": 7, "y": 4, "keyId": "prop-key" },
    { "id": "confetti-burst", "kind": "bomb", "x": 11, "y": 3, "atTurn": 9 }
  ],
  "objectives": [{ "type": "collect", "itemIds": ["piano-roll"] }, { "type": "exit", "x": 2, "y": 6 }],
  "turnLimit": 30,
  "allowedApi": ["move", "wait", "pick"],
  "cards": [
    { "id": "up", "label": { "zh": "向上", "en": "Move up" }, "template": "move(\"up\")" },
    { "id": "right", "label": { "zh": "向右", "en": "Move right" }, "template": "move(\"right\")" },
    { "id": "down", "label": { "zh": "向下", "en": "Move down" }, "template": "move(\"down\")" },
    { "id": "left", "label": { "zh": "向左", "en": "Move left" }, "template": "move(\"left\")" },
    { "id": "wait", "label": { "zh": "等一回合", "en": "Wait one turn" }, "template": "wait()" },
    { "id": "pick", "label": { "zh": "打开道具箱", "en": "Open the prop chest" }, "template": "pick()" },
    {
      "id": "repeat",
      "label": { "zh": "重复几次", "en": "Repeat" },
      "template": "for step in range({{count}}):",
      "block": true,
      "parameters": [
        {
          "name": "count",
          "label": { "zh": "次数", "en": "Times" },
          "choices": [
            { "id": "n2", "label": { "zh": "2", "en": "2" }, "code": "2" },
            { "id": "n3", "label": { "zh": "3", "en": "3" }, "code": "3" },
            { "id": "n4", "label": { "zh": "4", "en": "4" }, "code": "4" },
            { "id": "n5", "label": { "zh": "5", "en": "5" }, "code": "5" },
            { "id": "n6", "label": { "zh": "6", "en": "6" }, "code": "6" }
          ]
        }
      ]
    }
  ],
  "solutionCards": [
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "up" }] },
    { "cardId": "repeat", "values": { "count": "n5" }, "children": [{ "cardId": "right" }] },
    { "cardId": "down" },
    { "cardId": "wait" },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "down" }] },
    { "cardId": "wait" },
    { "cardId": "down" },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "left" }] },
    { "cardId": "down" },
    { "cardId": "up" },
    { "cardId": "left" },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "up" }] },
    { "cardId": "repeat", "values": { "count": "n5" }, "children": [{ "cardId": "left" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "down" }] },
    { "cardId": "pick" },
    { "cardId": "down" }
  ]
