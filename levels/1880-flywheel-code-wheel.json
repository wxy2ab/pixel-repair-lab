      "id": "seed",
      "label": {
        "zh": "读取起始码",
        "en": "Read the initial code"
      },
      "template": "code = board[\"seed\"]"
    },
    {
      "id": "combine",
      "label": {
        "zh": "滚动合成新码",
        "en": "Update the rolling code"
      },
      "template": "code = (code * 2 + board[\"marks\"][part]) % 31"
    },
