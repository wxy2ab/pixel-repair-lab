  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "first_start = [2, 5]\nif scan()[\"player\"] == first_start:\n    route = [\"U\", \"U\", \"U\", \"U\", \"P\", \"D\", \"W\", \"D\", \"R\", \"R\", \"D\", \"R\", \"R\", \"R\", \"P\", \"U\", \"U\", \"U\"]\nelse:\n    route = [\"U\", \"P\", \"R\", \"L\", \"D\", \"D\", \"D\", \"R\", \"R\", \"U\", \"R\", \"P\", \"R\", \"R\", \"D\", \"D\", \"L\"]\ndirections = {\"U\": \"up\", \"R\": \"right\", \"D\": \"down\", \"L\": \"left\"}\nfor action in route:\n    if action == \"P\":\n        pick()\n    elif action == \"W\":\n        wait()\n    else:\n        move(directions[action])\n",
