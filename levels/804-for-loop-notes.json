  "concept": {
    "zh": "逐块取数、重复计算、记录结果",
    "en": "Visit each battery, repeat a calculation, and record the results"
  },
  "brief": {
    "zh": "给一排电池各补 3 格。看看芽芽怎样一块一块地处理它们，又在什么时候停下来。",
    "en": "Add 3 units to every battery in a row. Follow Sprout as each battery is handled, and see when the loop ends."
  },
