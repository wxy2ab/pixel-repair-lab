  "cards": [
    {
      "id": "read",
      "label": {
        "zh": "读入电报",
        "en": "Read the telegram"
      },
      "template": "telegram = scan()"
    },
    {
      "id": "packets",
      "label": {
        "zh": "逐包处理",
        "en": "Process each packet"
      },
      "template": "for packet in telegram[\"packets\"]:",
      "block": true
    },
    {
      "id": "decode",
      "label": {
        "zh": "查方向字典",
        "en": "Look up direction"
      },
      "template": "direction = telegram[\"directions\"][packet[0]]"
    },
    {
      "id": "repeat",
      "label": {
        "zh": "按包内次数重复",
        "en": "Repeat the requested count"
      },
      "template": "for step_number in range(packet[1]):",
      "block": true
    },
    {
      "id": "move-decoded",
      "label": {
        "zh": "按解出的方向移动",
        "en": "Move in the decoded direction"
      },
      "template": "move(direction)"
    },
    {
      "id": "move",
      "label": {
