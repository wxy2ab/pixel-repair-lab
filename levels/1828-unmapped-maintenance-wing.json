  "cards": [
    {
      "id": "visited",
      "label": {
        "zh": "建立访问记录",
        "en": "Create the visit record"
      },
      "template": "visited = {}"
    },
    {
      "id": "offsets",
      "label": {
        "zh": "建立方向坐标表",
        "en": "Set direction offsets"
      },
      "template": "offsets = {\"up\": [0, -1], \"right\": [1, 0], \"down\": [0, 1], \"left\": [-1, 0]}"
    },
    {
      "id": "opposites",
      "label": {
        "zh": "建立方向反查表",
        "en": "Set opposite directions"
      },
      "template": "opposite = {\"up\": \"down\", \"right\": \"left\", \"down\": \"up\", \"left\": \"right\"}"
    },
    {
      "id": "define",
      "label": {
        "zh": "定义搜索一格的函数",
        "en": "Define a function to search from a tile"
      },
      "template": "def sweep(x, y):",
      "block": true
    },
    {
      "id": "mark",
      "label": {
        "zh": "把当前坐标标为已访问",
        "en": "Mark the current tile visited"
      },
      "template": "visited[str(x) + \",\" + str(y)] = True"
    },
    {
      "id": "scan",
      "label": {
        "zh": "扫描相邻格子",
        "en": "Scan the neighboring tiles"
      },
      "template": "nearby = scan()"
    },
    {
      "id": "direction",
      "label": {
        "zh": "逐个检查相邻方向",
        "en": "Inspect each neighboring direction"
      },
      "template": "for direction in offsets:",
      "block": true
    },
    {
      "id": "x",
      "label": {
        "zh": "计算邻格横坐标",
        "en": "Compute neighbor X"
      },
      "template": "nx = x + offsets[direction][0]"
    },
    {
      "id": "y",
      "label": {
        "zh": "计算邻格纵坐标",
        "en": "Compute neighbor Y"
      },
      "template": "ny = y + offsets[direction][1]"
    },
    {
      "id": "walkable",
      "label": {
        "zh": "相邻格可走且未访问",
        "en": "If the neighbor is walkable and unvisited"
      },
      "template": "if nearby[direction] != \"wall\" and str(nx) + \",\" + str(ny) not in visited:",
      "block": true
    },
    {
      "id": "advance",
      "label": {
        "zh": "走到邻格",
        "en": "Step into the neighbor"
      },
      "template": "move(direction)"
    },
    {
      "id": "part",
      "label": {
        "zh": "如果走进了零件格",
        "en": "If this tile showed a part"
      },
      "template": "if nearby[direction] == \"item\":",
      "block": true
    },
    {
      "id": "pick",
      "label": {
        "zh": "拾取零件",
        "en": "Pick up the part"
      },
      "template": "pick()"
    },
    {
      "id": "recurse",
      "label": {
        "zh": "搜索邻格的分支",
        "en": "Explore branches from that tile"
      },
      "template": "sweep(nx, ny)"
    },
    {
      "id": "back",
      "label": {
        "zh": "返回上一个格子",
        "en": "Go back to the previous tile"
      },
      "template": "move(opposite[direction])"
    },
    {
      "id": "begin",
      "label": {
        "zh": "从相对坐标零点出发",
        "en": "Begin at relative coordinates zero"
      },
      "template": "sweep(0, 0)"
    }
  ],
