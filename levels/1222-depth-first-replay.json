            "port": [
              "shed"
            ],
            "shed": [
              "port",
              "yard"
            ],
            "yard": [
              "shed"
            ]
          },
          "start": "port"
        },
        "allowedApi": [
          "scan",
          "submit"
        ],
        "objectives": [
          {
            "type": "submit",
            "values": [
              "port",
              "shed",
