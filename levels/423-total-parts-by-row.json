    },
    {
      "id": "reset",
      "label": {
        "zh": "把这一排的合计归零",
        "en": "Reset the total for this row"
      },
      "template": "total = 0"
    },
    {
      "id": "part",
      "label": {
        "zh": "逐个处理这一排的零件",
        "en": "For each item in this row"
      },
      "template": "for part in row:",
      "block": true
    },
    {
      "id": "add",
      "label": {
        "zh": "累加一件零件",
        "en": "Add one item to the total"
      },
      "template": "total = total + part"
    },
    {
      "id": "submit-total",
      "label": {
        "zh": "提交这一排合计",
        "en": "Submit this row's total"
      },
      "template": "submit(total)"
    }
