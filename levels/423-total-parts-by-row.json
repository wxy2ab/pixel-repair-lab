  "topic": { "id": "nested-loops", "order": 2, "title": { "zh": "嵌套循环", "en": "Nested Loops" } },
  "title": {
    "zh": "清点不同长度的零件架",
    "en": "Count Parts on Uneven Shelves"
  },
  "concept": {
    "zh": "两层循环与空输入",
    "en": "Nested loops and empty inputs"
  },
  "brief": {
    "zh": "每个货架有若干排，长度可能不同。按排提交零件数之和，空排也要提交 0。",
    "en": "The shelves have rows of different lengths. Submit the sum for each row in order. Submit 0 for an empty row."
  },
  "hints": [
    {
      "zh": "在外层循环开始时给当前排归零，内层循环一项项累加，走出内层再提交。",
      "en": "Reset the total at the start of each outer round. Add items in the inner loop and submit after that loop ends."
    }
  ],
  "tiles": [
    "#######",
    "#.....#",
    "#.....#",
    "#.....#",
    "#######"
  ],
  "start": {
    "x": 2,
    "y": 2
  },
