  "cards": [
    {
      "id": "read",
      "label": {
        "zh": "扫描每一排",
        "en": "Scan the rows"
      },
      "template": "rows = scan()"
    },
    {
      "id": "row",
      "label": {
        "zh": "逐排处理",
        "en": "For each row"
      },
      "template": "for row in rows:",
