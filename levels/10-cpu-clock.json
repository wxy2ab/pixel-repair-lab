  "title": {
    "zh": "CPU 的四个时钟",
    "en": "Four Ticks of the CPU"
  },
  "concept": {
    "zh": "指令、程序计数器与累加器",
    "en": "Instructions, program counter, and accumulator"
  },
  "brief": {
    "zh": "处理器已经装入一段程序。让它逐条执行指令，把前两个地址的数相加并存入地址 2，最后停在 HALT。",
    "en": "The processor has a program ready. Execute it one instruction at a time to add the first two memory values, write the result to address 2, and reach HALT."
  },
  "hints": [
    {
      "zh": "每个 step() 执行一条指令。程序计数器指向下一条指令，累加器保存计算中的值。",
      "en": "Each step() executes one instruction. The program counter points to the next instruction and the accumulator holds the running value."
    },
    {
      "zh": "LOAD 读取第一个值，ADD 加上第二个，STORE 写入结果，HALT 停机。",
      "en": "LOAD reads the first value, ADD adds the second, STORE writes the result, and HALT stops the processor."
    }
  ],
  "tiles": [
    "#########",
    "#.......#",
    "#.##.##.#",
    "#.......#",
    "#.#...#.#",
    "#.......#",
    "#########"
  ],
