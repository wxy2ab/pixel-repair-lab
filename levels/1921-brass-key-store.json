{
  "version": 1,
  "kind": "grid",
  "id": "challenge-brass-key-store",
  "order": 1921,
  "difficulty": "starter",
  "unit": { "id": "challenge-zone", "order": 90, "title": { "zh": "挑战场", "en": "Challenge Arena" } },
  "stage": "challenge",
  "prerequisites": [{ "unit": "foundations", "topic": "sequence" }],
  "title": { "zh": "黄铜钥匙仓", "en": "The Brass-Key Store" },
  "concept": { "zh": "钥匙 · 锁门 · 宝箱", "en": "Key · Locked door · Chest" },
  "brief": {
    "zh": "把仓里的备用齿轮带到出口。经过黄铜钥匙就能拿到它；同一把钥匙既能解锁门，也能打开齿轮箱。站在箱子上点「打开脚下的宝箱」，开箱也用一回合。步数上限是 13。",
    "en": "Take the spare gear to the exit in at most 13 turns. Step on the brass key to collect it. It unlocks both the door and the gear chest. Open the chest while standing on it. Opening it takes one turn."
  },
  "hints": [],
  "tiles": ["#######", "#...###", "#.#####", "#.....#", "#####.#", "#######"],
  "start": { "x": 1, "y": 2 },
  "turnLimit": 13,
  "allowedApi": ["move", "pick"],
  "devices": [
    { "kind": "key", "id": "brass-key", "x": 3, "y": 1 },
    { "kind": "door", "id": "store-door", "x": 3, "y": 3, "keyId": "brass-key" },
    { "kind": "chest", "id": "gear-chest", "x": 5, "y": 3, "keyId": "brass-key" }
  ],
  "objectives": [{ "type": "collect", "itemIds": ["gear-chest"] }, { "type": "exit", "x": 5, "y": 4 }],
  "cards": [
    { "id": "up", "label": { "zh": "向上", "en": "Move up" }, "template": "move(\"up\")" },
    { "id": "right", "label": { "zh": "向右", "en": "Move right" }, "template": "move(\"right\")" },
    { "id": "down", "label": { "zh": "向下", "en": "Move down" }, "template": "move(\"down\")" },
    { "id": "left", "label": { "zh": "向左", "en": "Move left" }, "template": "move(\"left\")" },
    {
      "id": "repeat",
      "label": { "zh": "重复几次", "en": "Repeat moves" },
      "template": "for step in range({{count}}):",
      "block": true,
      "parameters": [
        {
          "name": "count",
          "label": { "zh": "次数", "en": "Times" },
          "choices": [
            { "id": "n2", "label": { "zh": "2", "en": "2" }, "code": "2" },
            { "id": "n3", "label": { "zh": "3", "en": "3" }, "code": "3" },
            { "id": "n4", "label": { "zh": "4", "en": "4" }, "code": "4" },
            { "id": "n5", "label": { "zh": "5", "en": "5" }, "code": "5" },
            { "id": "n6", "label": { "zh": "6", "en": "6" }, "code": "6" }
          ]
        }
      ]
    },
    { "id": "pick", "label": { "zh": "打开脚下的宝箱", "en": "Open this chest" }, "template": "pick()" }
  ],
  "solutionCards": [
    { "cardId": "up" },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "right" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "left" }] },
    { "cardId": "repeat", "values": { "count": "n2" }, "children": [{ "cardId": "down" }] },
    { "cardId": "repeat", "values": { "count": "n4" }, "children": [{ "cardId": "right" }] },
    { "cardId": "pick" },
    { "cardId": "down" }
  ]
}
