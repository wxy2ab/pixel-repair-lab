  "order": 1923,
  "difficulty": "intermediate",
  "unit": { "id": "challenge-zone", "order": 90, "title": { "zh": "挑战场", "en": "Challenge Arena" } },
  "stage": "challenge",
  "prerequisites": [{ "unit": "foundations", "topic": "sequence" }, { "unit": "python-intermediate", "topic": "for-loops" }],
  "title": { "zh": "脉冲炮横道", "en": "Pulse-Cannon Crossing" },
  "concept": { "zh": "周期 · 等待 · 两张地图", "en": "Turn cycles · Waiting · Two maps" },
  "brief": {
    "zh": "把芽芽送过检修横道。两张图的脉冲炮都在第 3、6、9……回合发出直线脉冲，覆盖前方整条通道。芽芽可以原地等一回合。用同一份程序在两张图上各用至多 7 回合抵达出口。",
    "en": "Cross the service aisle on both maps. Each cannon pulses down its lane on turns 3, 6, 9 and so on. Sprout can wait in place for one turn. Use the same program to reach the exit on each map in at most 7 turns."
  },
  "hints": [],
  "tiles": ["#########", "####.####", "#.......#", "####.####", "####.####", "#########"],
  "start": { "x": 1, "y": 2 },
  "turnLimit": 7,
  "allowedApi": ["move", "wait"],
  "devices": [{ "kind": "cannon", "id": "pulse-post", "x": 4, "y": 1, "direction": "down", "period": 3 }],
  "objectives": [{ "type": "exit", "x": 7, "y": 2 }],
  "variants": [
    {
      "tiles": ["#########", "#.##.####", "#.......#", "####.##.#", "####.####", "#########"],
      "devices": [{ "kind": "cannon", "id": "pulse-post", "x": 4, "y": 4, "direction": "up", "period": 3 }]
    }
  ],
  "cards": [
    { "id": "up", "label": { "zh": "向上", "en": "Move up" }, "template": "move(\"up\")" },
    { "id": "right", "label": { "zh": "向右", "en": "Move right" }, "template": "move(\"right\")" },
    { "id": "down", "label": { "zh": "向下", "en": "Move down" }, "template": "move(\"down\")" },
    { "id": "left", "label": { "zh": "向左", "en": "Move left" }, "template": "move(\"left\")" },
    {
      "id": "repeat",
      "label": { "zh": "重复几次", "en": "Repeat moves" },
      "template": "for step in range({{count}}):",
      "block": true,
      "parameters": [
        {
          "name": "count",
          "label": { "zh": "次数", "en": "Times" },
          "choices": [
            { "id": "n2", "label": { "zh": "2", "en": "2" }, "code": "2" },
            { "id": "n3", "label": { "zh": "3", "en": "3" }, "code": "3" },
            { "id": "n4", "label": { "zh": "4", "en": "4" }, "code": "4" },
            { "id": "n5", "label": { "zh": "5", "en": "5" }, "code": "5" },
            { "id": "n6", "label": { "zh": "6", "en": "6" }, "code": "6" }
          ]
        }
      ]
    },
    { "id": "wait", "label": { "zh": "原地等一回合", "en": "Wait one turn" }, "template": "wait()" }
  ],
  "solutionCards": [
    { "cardId": "wait" },
    { "cardId": "repeat", "values": { "count": "n6" }, "children": [{ "cardId": "right" }] }
  ]
}
