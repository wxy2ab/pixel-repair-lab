  "cards": [
    {
      "id": "scan",
      "label": {
        "zh": "读取七个读数",
        "en": "Read the seven readings"
      },
      "template": "values = scan()"
    },
    {
      "id": "bays",
      "label": {
        "zh": "遍历所有检修口",
        "en": "Visit all service bays"
      },
      "template": "for i in range(len(values)):",
      "block": true
    },
    {
      "id": "inner",
      "label": {
        "zh": "只检查内侧工位",
        "en": "Inspect interior bays"
      },
      "template": "if i > 0 and i < len(values) - 1:",
      "block": true
    },
    {
      "id": "crest",
      "label": {
        "zh": "严格高于两旁",
        "en": "Higher than both neighbors"
      },
      "template": "if values[i] > values[i-1] and values[i] > values[i+1]:",
      "block": true
    },
    {
      "id": "trough",
      "label": {
        "zh": "严格低于两旁",
        "en": "Lower than both neighbors"
      },
      "template": "if values[i] < values[i-1] and values[i] < values[i+1]:",
      "block": true
    },
    {
      "id": "up",
      "label": {
        "zh": "上移",
        "en": "Up"
      },
      "template": "move(\"up\")"
    },
    {
      "id": "down",
      "label": {
        "zh": "下移",
        "en": "Down"
      },
      "template": "move(\"down\")"
    },
    {
      "id": "right",
      "label": {
        "zh": "右移",
        "en": "Right"
      },
      "template": "move(\"right\")"
    },
    {
      "id": "pick",
      "label": {
        "zh": "取件",
        "en": "Collect"
      },
      "template": "pick()"
    },
    {
      "id": "sample",
      "label": {
        "zh": "提交当前读数",
        "en": "Submit this reading"
      },
      "template": "submit(values[i])"
    }
  ],
