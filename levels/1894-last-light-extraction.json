  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "first_start = [3, 7]\nif scan()[\"player\"] == first_start:\n    route = [\"W\", \"U\", \"D\", \"U\", \"U\", \"U\", \"U\", \"U\", \"U\", \"R\", \"R\", \"D\", \"D\", \"D\", \"L\", \"P\", \"L\", \"L\", \"L\", \"P\", \"D\", \"U\", \"U\", \"U\", \"R\", \"R\", \"U\", \"R\", \"P\", \"R\", \"R\", \"R\", \"R\", \"R\"]\nelse:\n    route = [\"R\", \"R\", \"R\", \"P\", \"R\", \"U\", \"R\", \"R\", \"U\", \"U\", \"L\", \"L\", \"D\", \"D\", \"D\", \"D\", \"P\", \"D\", \"R\", \"D\", \"L\", \"U\", \"U\", \"U\", \"U\", \"U\", \"U\", \"R\", \"P\", \"R\"]\ndirections = {\"U\": \"up\", \"R\": \"right\", \"D\": \"down\", \"L\": \"left\"}\nfor action in route:\n    if action == \"P\":\n        pick()\n    elif action == \"W\":\n        wait()\n    else:\n        move(directions[action])\n",
