  "brief": {
    "zh": "用一条具体的反馈修正清单，保留已经正确的内容。",
    "en": "Give precise feedback that fixes a manifest and preserves the correct entries."
  },
  "concept": {
    "zh": "修正提示词写明要改的物品、目标数量及保留要求。",
    "en": "Name the item, final quantity, and entries to preserve."
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "说出需要的最终数量",
        "en": "Give the final quantity"
      },
      "body": {
        "zh": "任务要四节电池。清单现在有五节，可以说“把电池改为四节”。写出最终数量，方便你下一轮核对。",
        "en": "The task calls for four batteries. If the list contains five, ask to set the battery count to four. The final quantity gives you a clear reference for the next check."
      }
    },
    {
      "title": {
        "zh": "告诉 AI 哪些内容要保留",
        "en": "Say what to keep"
      },
      "body": {
        "zh": "可以补一句“把其他物品保持原样”。如果有多处差异，就把每一处的改法分别说明。",
        "en": "You can add “Keep the other items as they are.” If several entries need changes, describe each change separately."
      }
    }
  ],
