  "title": { "zh": "内存轮换接力", "en": "Memory Relay" },
  "concept": { "zh": "原地轮换 · 留存核对值", "en": "In-place relay · Verification value" },
  "brief": {
    "zh": "把地址 0、1、2 的电量原地轮换：原 0 号移到 2 号，原 1 号移到 0 号，原 2 号移到 1 号。用轮换前的电量算出核对值（原 0 号 + 原 1 号 − 原 2 号），同时写入地址 3 和 ACC。保留地址 4 的备用电量。同一份程序须在四组数据中都通过。",
    "en": "Rotate the readings in addresses 0, 1, and 2 in place: move old 0 to address 2, old 1 to address 0, and old 2 to address 1. Compute the verification value from the original readings (old 0 + old 1 − old 2) and leave it in both address 3 and ACC. Keep the reserve at address 4 intact. One program must pass all four cases."
  },
  "hints": [],
  "allowedOps": ["LOAD", "ADD", "SUB", "STORE", "HALT"],
  "starterCode": "HALT\n",
  "solutionCode": "LOAD 0\nSTORE 3\nLOAD 1\nSTORE 0\nLOAD 2\nSTORE 1\nLOAD 3\nSTORE 2\nADD 0\nSUB 1\nSTORE 3\nHALT\n",
