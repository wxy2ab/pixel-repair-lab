{
  "version": 1,
  "kind": "grid",
  "id": "challenge-bent-light-gallery",
  "order": 1922,
  "difficulty": "intermediate",
  "unit": { "id": "challenge-zone", "order": 90, "title": { "zh": "挑战场", "en": "Challenge Arena" } },
  "stage": "challenge",
  "prerequisites": [{ "unit": "foundations", "topic": "sequence" }, { "unit": "python-intermediate", "topic": "branches" }],
  "title": { "zh": "拐弯的光廊", "en": "The Bent-Light Gallery" },
  "concept": { "zh": "激光 · 反射镜 · 地板开关", "en": "Laser · Mirror · Floor switch" },
  "brief": {
    "zh": "光廊的激光碰到斜镜会拐弯。芽芽在回合结束时站在亮线里就会停机。踩下侧廊的开关后，发射器会一直关闭。10 回合内到达出口。",
    "en": "A mirror bends the laser beam around the corner. Sprout shuts down if a turn ends on the lit beam. The side hall has a floor switch that keeps the emitter off once pressed. Reach the exit in 10 turns."
  },
  "hints": [],
  "tiles": ["#########", "#....####", "#.##.####", "#.......#", "######..#", "#########"],
  "start": { "x": 2, "y": 3 },
  "turnLimit": 10,
  "allowedApi": ["move"],
  "devices": [
    { "kind": "laser", "id": "gallery-light", "x": 1, "y": 1, "direction": "right", "switchId": "cutoff" },
    { "kind": "mirror", "id": "corner-mirror", "x": 4, "y": 1, "orientation": "\\" },
    { "kind": "switch", "id": "cutoff", "x": 1, "y": 2 }
  ],
  "objectives": [{ "type": "exit", "x": 7, "y": 4 }],
  "cards": [
    { "id": "up", "label": { "zh": "向上", "en": "Move up" }, "template": "move(\"up\")" },
    { "id": "right", "label": { "zh": "向右", "en": "Move right" }, "template": "move(\"right\")" },
    { "id": "down", "label": { "zh": "向下", "en": "Move down" }, "template": "move(\"down\")" },
    { "id": "left", "label": { "zh": "向左", "en": "Move left" }, "template": "move(\"left\")" },
    {
      "id": "repeat",
      "label": { "zh": "重复几次", "en": "Repeat moves" },
      "template": "for step in range({{count}}):",
      "block": true,
      "parameters": [
        {
          "name": "count",
          "label": { "zh": "次数", "en": "Times" },
          "choices": [
            { "id": "n2", "label": { "zh": "2", "en": "2" }, "code": "2" },
            { "id": "n3", "label": { "zh": "3", "en": "3" }, "code": "3" },
            { "id": "n4", "label": { "zh": "4", "en": "4" }, "code": "4" },
            { "id": "n5", "label": { "zh": "5", "en": "5" }, "code": "5" },
            { "id": "n6", "label": { "zh": "6", "en": "6" }, "code": "6" }
          ]
        }
      ]
    }
  ],
  "solutionCards": [
    { "cardId": "left" },
    { "cardId": "up" },
    { "cardId": "down" },
    { "cardId": "repeat", "values": { "count": "n6" }, "children": [{ "cardId": "right" }] },
    { "cardId": "down" }
  ]
}
