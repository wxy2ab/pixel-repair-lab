  "topic": {
    "id": "masks",
    "order": 2,
    "title": {
      "zh": "布尔掩码",
      "en": "Boolean masks"
    }
  },
  "title": {
    "zh": "一次筛选一整列",
    "en": "Filter a Whole Column"
  },
  "brief": {
    "zh": "给每条读数标出 True 或 False，再保留符合条件的记录。",
    "en": "Mark every reading True or False, then keep matching records."
  },
  "concept": {
    "zh": "布尔掩码的每个位置与原表的同一行对应。",
    "en": "Each mask position matches the same row in the original table."
  },
  "hints": [],
  "sections": [
    {
      "title": {
        "zh": "比较整列",
        "en": "Compare a whole column"
      },
      "body": {
        "zh": "用 NumPy 写 readings >= 25，每个温度与 25 比较一次，得到一列布尔值。",
        "en": "With NumPy, readings >= 25 compares each temperature with 25 and produces an array of Boolean values."
      }
    },
    {
      "title": {
        "zh": "按掩码选行",
        "en": "Select rows with the mask"
      },
      "body": {
        "zh": "位置 0 的掩码如果为 True，就保留原表第 0 号行。把掩码放进方括号，保留下来的行仍按原顺序排列。",
        "en": "A True at position 0 selects the first row of the original table. Apply a mask with brackets, and the selected rows keep their original order."
      }
    },
    {
      "title": {
        "zh": "等号会保留边界",
        "en": "Equality includes the boundary"
      },
      "body": {
        "zh": "≥ 25 会保留 25。要找出不超过某个数的读数，用 ≤。",
        "en": "≥ 25 keeps 25. Use ≤ to find values at or below the cutoff."
      }
    }
  ],
