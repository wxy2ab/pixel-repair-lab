  "cards": [
    {
      "id": "read",
      "label": {
        "zh": "读入所有工单",
        "en": "Read the orders"
      },
      "template": "batches = scan()"
    },
    {
      "id": "batch",
      "label": {
        "zh": "逐批处理",
        "en": "Process one batch at a time"
      },
      "template": "for batch in batches:",
      "block": true
    },
    {
      "id": "urgent-queue",
      "label": {
        "zh": "建空的紧急队列",
        "en": "Create an empty urgent queue"
      },
      "template": "urgent = []"
    },
    {
      "id": "standard-queue",
      "label": {
        "zh": "建空的普通队列",
        "en": "Create an empty standard queue"
      },
      "template": "standard = []"
    },
    {
      "id": "order",
      "label": {
        "zh": "按到达顺序看每张工单",
        "en": "Read the batch in arrival order"
      },
      "template": "for order in batch:",
      "block": true
    },
    {
      "id": "if-urgent",
      "label": {
        "zh": "紧急工单",
        "en": "If this order is urgent"
      },
      "template": "if order[0] == \"urgent\":",
      "block": true
    },
    {
      "id": "else",
      "label": {
        "zh": "其他工单",
        "en": "For any other order"
      },
      "template": "else:",
      "block": true
    },
    {
      "id": "enqueue-urgent",
      "label": {
        "zh": "方向加入紧急队尾",
        "en": "Add direction to the urgent queue"
      },
      "template": "urgent.append(order[1])"
    },
    {
      "id": "enqueue-standard",
      "label": {
        "zh": "方向加入普通队尾",
        "en": "Add direction to the standard queue"
      },
      "template": "standard.append(order[1])"
    },
    {
      "id": "next-urgent",
      "label": {
        "zh": "紧急队列还有工单",
        "en": "While the urgent queue has orders"
      },
      "template": "while urgent:",
      "block": true
    },
    {
      "id": "next-standard",
      "label": {
        "zh": "普通队列还有工单",
        "en": "While the standard queue has orders"
      },
      "template": "while standard:",
      "block": true
    },
    {
      "id": "depart-urgent",
      "label": {
        "zh": "从紧急队头取方向并移动",
        "en": "Move using the front urgent order"
      },
      "template": "move(urgent.pop(0))"
    },
    {
      "id": "depart-standard",
      "label": {
        "zh": "从普通队头取方向并移动",
        "en": "Move using the front standard order"
      },
      "template": "move(standard.pop(0))"
    },
    {
      "id": "pick",
      "label": {
        "zh": "拾取零件",
        "en": "Pick up the part"
      },
      "template": "pick()"
    }
