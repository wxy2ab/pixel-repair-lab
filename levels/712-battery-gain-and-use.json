  "brief": {
    "zh": "先把扫描到的电量存起来，充电增加 4 格，打开修理灯再用掉 2 格。最后提交剩下的电量。",
    "en": "Save the battery reading, charge it by four units, then spend two units on the lamp. Submit the charge that remains."
  },
  "hints": [
    {
      "zh": "每次都用变量里当前的数值算出下一步的数值。",
      "en": "Use the current value of the variable at each step to calculate its next value."
    }
