  "brief": {
    "zh": "pair_decision(low, high, target) 返回 left、right 或 match，分别表示移动左端、移动右端或找到一对。",
    "en": "Return left, right, or match from pair_decision(low, high, target), depending on which end should move or whether a pair matches."
  },
  "concept": {
    "zh": "拆出一条决策规则",
    "en": "Extract a decision rule"
  },
  "hints": [],
  "functionName": "pair_decision",
  "starterCode": "def pair_decision(low, high, target):\n    return \"match\"",
  "solutionCode": "def pair_decision(low, high, target):\n    total = low + high\n    if total < target:\n        return \"left\"\n    if total > target:\n        return \"right\"\n    return \"match\"",
  "snippets": [
    {
      "label": {
        "zh": "先算两端之和",
        "en": "Add the two ends"
      },
      "code": "    total = low + high"
    },
    {
      "label": {
        "zh": "比较目标",
        "en": "Compare with target"
      },
      "code": "    if total < target:\n        return \"left\"\n    if total > target:\n        return \"right\""
    }
  ],
