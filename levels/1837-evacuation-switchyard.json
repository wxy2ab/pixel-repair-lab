  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "state = scan()\nif state[\"player\"][0] < 7:\n    plan = [\"right\",\"right\",\"right\",\"down\",\"down\",\"left\",\"left\",\"up\",\"up\",\"up\",\"right\",\"pick\",\"right\",\"down\",\"down\",\"right\",\"down\",\"right\",\"right\",\"right\",\"pick\",\"right\",\"right\",\"right\"]\nelse:\n    plan = [\"left\",\"left\",\"up\",\"up\",\"up\",\"down\",\"down\",\"pick\",\"down\",\"left\",\"down\",\"down\",\"left\",\"left\",\"left\",\"left\",\"pick\",\"left\",\"left\",\"left\"]\nfor action in plan:\n    if action == \"pick\":\n        pick()\n    elif action == \"wait\":\n        wait()\n    else:\n        move(action)\n",
  "snippets": [
    {
      "label": {
        "zh": "查看对手位置",
        "en": "Read opponent positions"
      },
      "code": "state = scan()\nfor robot in state[\"opponents\"]:\n    x = robot[\"x\"]\n    y = robot[\"y\"]"
