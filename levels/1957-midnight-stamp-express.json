  "title": {"zh": "零点邮戳快车", "en": "Midnight Stamp Express"},
  "concept": {"zh": "三枚邮戳 · 双点脉冲", "en": "Three stamps · Pulse crossings"},
  "brief": {
    "zh": "拿齐三枚纪念邮戳，到东站赶零点快车。邮戳箱分散在三个站台。西信号炮从第 2 回合起每三回合扫过西线。东信号炮从第 1 回合起每四回合扫过东线。站在箱上取戳也用一回合。限 56 回合。",
    "en": "Bring all three stamp chests to the east station for the midnight express. Each platform holds one chest. The west signal sweeps its line on turns 2, 5, 8 and every third turn after that. The east signal sweeps its line every fourth turn starting on turn 1. Taking a stamp on its square costs a turn. Finish within 56 turns."
  },
  "hints": [],
  "tiles": [
    "####################",
    "######......########",
    "######...........###",
    "###.........#.##.###",
    "###.##.###.##.##.###",
    "#....#.###.##.##.###",
    "#..................#",
    "#....#.###.##.#....#",
    "###.##.###.##.#....#",
    "###.##.###.##.#....#",
    "###...........#....#",
    "######.##........###",
    "#########....#######",
    "####################"
  ],
  "start": {"x": 1, "y": 6},
  "turnLimit": 56,
  "allowedApi": [
    "move",
    "pick",
    "wait"
  ],
  "devices": [
    {"kind": "cannon", "id": "west-signal", "x": 6, "y": 1, "direction": "down", "period": 3, "phase": 2},
    {"kind": "cannon", "id": "east-signal", "x": 13, "y": 11, "direction": "up", "period": 4, "phase": 1},
    {"kind": "chest", "id": "comet-stamp", "x": 8, "y": 1},
    {"kind": "chest", "id": "whale-stamp", "x": 9, "y": 12},
    {"kind": "chest", "id": "fox-stamp", "x": 18, "y": 10}
  ],
  "objectives": [
    {"type": "collect", "itemIds": ["comet-stamp", "whale-stamp", "fox-stamp"]},
    {"type": "exit", "x": 18, "y": 6}
  ],
  "cards": [
    {"id": "up", "label": {"zh": "向上", "en": "Move up"}, "template": "move(\"up\")"},
    {"id": "right", "label": {"zh": "向右", "en": "Move right"}, "template": "move(\"right\")"},
