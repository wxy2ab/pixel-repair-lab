            {"id": "n11", "label": {"zh": "11", "en": "11"}, "code": "11"}
          ]
        }
      ]
    },
    {"id": "pick", "label": {"zh": "打开脚下的宝箱", "en": "Open this chest"}, "template": "pick()"},
    {"id": "wait", "label": {"zh": "原地等一回合", "en": "Wait one turn"}, "template": "wait()"}
  ],
