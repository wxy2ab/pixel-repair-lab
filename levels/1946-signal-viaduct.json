  "starterCode": "state = scan()\n",
  "solutionCode": "def ride(legs):\n    for leg in legs:\n        for square in range(leg[1]):\n            move(leg[0])\n\nflag = scan()[\"items\"][0]\nif flag[\"x\"] < 7:\n    to_flag = [[\"up\", 3], [\"right\", 1], [\"up\", 2], [\"right\", 1], [\"up\", 3]]\n    to_exit = [[\"down\", 3], [\"right\", 5], [\"down\", 1], [\"right\", 4], [\"down\", 1], [\"right\", 3], [\"down\", 2], [\"right\", 1], [\"down\", 1], [\"right\", 1], [\"down\", 1]]\nelse:\n    to_flag = [[\"right\", 4], [\"up\", 1], [\"right\", 1], [\"up\", 2], [\"right\", 4], [\"up\", 5], [\"right\", 1]]\n    to_exit = [[\"right\", 3], [\"down\", 1], [\"right\", 1], [\"down\", 4], [\"left\", 1], [\"down\", 3], [\"right\", 3], [\"down\", 1]]\n\nride(to_flag)\npick()\nride(to_exit)\n",
