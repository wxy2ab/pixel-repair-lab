  "starterCode": "while True:\n    state = scan()\n    wait()\n",
  "solutionCode": "DIRECTIONS = [\"up\", \"right\", \"down\", \"left\"]\n\ndef make_graph(board, width):\n    graph = {}\n    offsets = [-width, 1, width, -1]\n    for y in range(1, len(board) - 1):\n        for x in range(1, width - 1):\n            if board[y][x] != \".\":\n                continue\n            cell = y * width + x\n            edges = []\n            for direction in range(4):\n                neighbor = cell + offsets[direction]\n                if board[neighbor // width][neighbor % width] == \".\":\n                    edges.append([neighbor, DIRECTIONS[direction]])\n            graph[cell] = edges\n    return graph\n\ndef routes(graph, cache, start):\n    if start in cache:\n        return cache[start]\n    table = {start: [0, None]}\n    queue = [start]\n    for cell in queue:\n        previous = table[cell]\n        for edge in graph[cell]:\n            neighbor = edge[0]\n            if neighbor in table:\n                continue\n            first = previous[1]\n            if first is None:\n                first = edge[1]\n            table[neighbor] = [previous[0] + 1, first]\n            queue.append(neighbor)\n    cache[start] = table\n    return table\n\ndef city_distance(x, y, other_x, other_y):\n    dx = x - other_x\n    dy = y - other_y\n    if dx < 0:\n        dx = -dx\n    if dy < 0:\n        dy = -dy\n    return dx + dy\n\ndef choose_action(state, width, graph, cache):\n    player = state[\"player\"]\n    start = player[1] * width + player[0]\n    cells = []\n    for item in state[\"items\"]:\n        cell = item[\"y\"] * width + item[\"x\"]\n        if start == cell:\n            return \"pick\"\n        cells.append(cell)\n    own = routes(graph, cache, start)\n    rivals = state[\"opponents\"]\r\n    chosen = None\n    best = -10000\n    for cell in cells:\n        if cell not in own:\n            continue\n        distance = own[cell][0]\n        priority = (state[\"turn\"] + distance) % (len(rivals) + 1)\n        lead = 999\n        safety = 3\n        for i in range(len(rivals)):\n            rival = rivals[i]\n            gap = city_distance(cell % width, cell // width, rival[\"x\"], rival[\"y\"]) - distance\r\n            if gap < lead:\n                lead = gap\n            if gap < 0:\n                safety = 0\n            elif gap == 0 and safety >= 2:\n                if priority > 0 and i + 1 >= priority:\n                    safety = 1\n                else:\n                    safety = 2\n        if lead > 3:\r\n            lead = 3\r\n        merit = safety * 100 - distance * 8 + lead\n        if merit > best:\n            best = merit\n            chosen = cell\n    if chosen is None:\n        return \"wait\"\n    return own[chosen][1]\n\nboard = []\ncache = {}\nwhile True:\n    state = scan()\n    if state[\"tiles\"] != board:\n        board = state[\"tiles\"]\n        width = len(board[0])\n        graph = make_graph(board, width)\n        cache = {}\n    action = choose_action(state, width, graph, cache)\n    if action == \"pick\":\n        pick()\n    elif action == \"wait\":\n        wait()\n    else:\n        move(action)\n",
