  "cards": [
    {
      "id": "read",
      "label": {
        "zh": "读电量和目标",
        "en": "Read charges and target"
      },
      "template": "order = scan()"
    },
    {
      "id": "empty",
      "label": {
        "zh": "准备配对名单",
        "en": "Prepare the pair list"
      },
      "template": "pair = []"
    },
    {
      "id": "first",
      "label": {
        "zh": "按位置试第一块",
        "en": "Test each first index in order"
      },
      "template": "for first in range(len(order[\"charges\"])):",
      "block": true
    },
    {
      "id": "second",
      "label": {
        "zh": "在右边试另一块",
        "en": "Test each second index to the right"
      },
      "template": "for second in range(first + 1, len(order[\"charges\"])):",
      "block": true
    },
    {
      "id": "match",
      "label": {
        "zh": "还没选中且两块刚好够",
        "en": "If no pair is chosen and the sum matches"
      },
      "template": "if len(pair) == 0 and (order[\"charges\"][first] + order[\"charges\"][second] == order[\"target\"]):",
      "block": true
    },
    {
      "id": "save",
      "label": {
        "zh": "记下两个位置",
        "en": "Save both indices"
      },
      "template": "pair = [first, second]"
    },
    {
      "id": "visit",
      "label": {
        "zh": "沿柜子依次查看六个位置",
        "en": "Visit the six cabinet positions in order"
      },
      "template": "for index in range(len(order[\"charges\"])):",
      "block": true
    },
    {
      "id": "selected",
      "label": {
        "zh": "当前位置属于配对",
        "en": "If this position is in the chosen pair"
      },
      "template": "if index in pair:",
      "block": true
    },
    {
      "id": "result",
      "label": {
        "zh": "按位置取出配对记录",
        "en": "Read each index from the pair list"
      },
      "template": "for slot in range(len(pair)):",
      "block": true
    },
    {
      "id": "send",
      "label": {
