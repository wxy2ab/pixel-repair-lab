  "cards": [
    {
      "id": "read",
      "label": {
        "zh": "读取图纸和工单",
        "en": "Read plan and work order"
      },
      "template": "board = scan()"
    },
    {
      "id": "N",
      "label": {
        "zh": "图纸北",
        "en": "Plan north"
      },
      "template": "move(board[\"compass\"][\"N\"])"
    },
    {
      "id": "E",
      "label": {
        "zh": "图纸东",
        "en": "Plan east"
      },
      "template": "move(board[\"compass\"][\"E\"])"
    },
    {
      "id": "S",
      "label": {
        "zh": "图纸南",
        "en": "Plan south"
      },
      "template": "move(board[\"compass\"][\"S\"])"
    },
    {
      "id": "W",
      "label": {
        "zh": "图纸西",
        "en": "Plan west"
      },
      "template": "move(board[\"compass\"][\"W\"])"
    },
    {
      "id": "grab",
      "label": {
        "zh": "拾取并读取件名",
        "en": "Pick up and read the ID"
      },
      "template": "part = pick()"
    },
    {
      "id": "cold-queue",
      "label": {
        "zh": "建立冷链队列",
        "en": "Start the cold queue"
      },
      "template": "cold = []"
    },
    {
      "id": "normal-queue",
      "label": {
        "zh": "建立常温队列",
        "en": "Start the regular queue"
      },
      "template": "regular = []"
    },
    {
      "id": "is-cold",
      "label": {
        "zh": "此件需要冷链",
        "en": "If this item needs chilling"
      },
      "template": "if board[\"cold\"][part] == 1:",
      "block": true
    },
    {
      "id": "cold-in",
      "label": {
        "zh": "加入冷链队尾",
        "en": "Enqueue for chilling"
      },
      "template": "cold.append(part)"
    },
    {
      "id": "otherwise",
      "label": {
        "zh": "否则",
        "en": "Otherwise"
      },
      "template": "else:",
      "block": true
    },
    {
      "id": "normal-in",
      "label": {
        "zh": "加入常温队尾",
        "en": "Enqueue for regular dispatch"
      },
      "template": "regular.append(part)"
    },
    {
      "id": "cold-waiting",
      "label": {
        "zh": "还有冷链件",
        "en": "While cold items remain"
      },
      "template": "while len(cold) > 0:",
      "block": true
    },
    {
      "id": "cold-out",
      "label": {
        "zh": "提交冷链队头",
        "en": "Dispatch cold front"
      },
      "template": "submit(cold.pop(0))"
    },
    {
      "id": "regular-waiting",
      "label": {
        "zh": "还有常温件",
        "en": "While regular items remain"
      },
      "template": "while len(regular) > 0:",
      "block": true
    },
    {
      "id": "regular-out",
      "label": {
        "zh": "提交常温队头",
        "en": "Dispatch regular front"
      },
      "template": "submit(regular.pop(0))"
    }
  ],
