  "hints": [],
  "mode": "grid",
  "examples": [
    {
      "title": {
        "zh": "顺序打乱的一批",
        "en": "Shuffled parts"
      },
      "source": "parts = scan()\nfor start in range(len(parts)):\n    smallest = start\n    for index in range(start + 1, len(parts)):\n        if parts[index] < parts[smallest]:\n            smallest = index\n    saved = parts[start]\n    parts[start] = parts[smallest]\n    parts[smallest] = saved\n    say(str(parts))\nsubmit(parts)",
      "scenario": {
        "tiles": [
          "#####",
          "#...#",
          "#####"
        ],
        "start": {
          "x": 1,
          "y": 1
        },
        "input": [
          6,
          3,
          2,
          5
        ],
        "allowedApi": [
          "scan",
          "say",
          "submit"
        ],
        "objectives": [
          {
            "type": "submit",
            "values": [
              [
                2,
                3,
                5,
                6
              ]
            ]
          }
        ]
      }
    },
